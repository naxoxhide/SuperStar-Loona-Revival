<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/videoProgressBar"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:progressDrawable="@drawable/adfit_video_progress"
        android:thumb="@null"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/videoSoundButton"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="8dp"
        android:src="@drawable/adfit_video_sound_off_btn"
        android:scaleType="fitCenter"
        android:contentDescription="@string/adfit_sound_off_description"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/videoPlayButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/adfit_video_play_btn"
        android:scaleType="fitCenter"
        android:contentDescription="@string/adfit_play_btn_description"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/videoLoadingProgressBar"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="fitCenter"
        android:indeterminate="true"
        android:indeterminateTint="#f2f2f2"
        android:indeterminateTintMode="src_atop"/>
</merge>
