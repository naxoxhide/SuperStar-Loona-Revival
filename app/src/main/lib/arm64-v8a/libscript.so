                            cachedCacTiers[1].push({ code: 1000 + tl - 1, level: tl, collectionPointType: 1, pointValue: 40 + (tl - 1) * 120, rewardItem: 4, rewardQuantity: Math.min(40000, 2000 + Math.floor((tl - 1) / 3) * 1000) });
