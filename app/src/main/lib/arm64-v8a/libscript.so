                        var sCard = pop.add(0x138).readPointer();
                        var nCard = pop.add(0x118).readPointer();
                        if (activePopupSession && activePopupSession.steps && activePopupSession.steps[0]) {
                            var st0 = activePopupSession.steps[0];
