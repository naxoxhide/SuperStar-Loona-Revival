                    Interceptor.replace(baseAddr.add(0x11CFDD8), keepCb(new NativeCallback(function (sceneThis, isReload, methodInfo) {
                        log("[📖 CARDBOOK] RefreshSetMainView intercepted -> populating complete offline UI!");
                        populateCardBookMainViewOffline(sceneThis);
                    }, "void", ["pointer", "int", "pointer"])));

                    // RefreshSetGroupViewPage (0x11CF768) -> Dedicated offline GroupView renderer
                    Interceptor.replace(baseAddr.add(0x11CF768), keepCb(new NativeCallback(function (sceneThis, page, isReload, methodInfo) {
                        log("[📖 CARDBOOK] RefreshSetGroupViewPage intercepted for page=" + page);
                        populateCardBookGroupViewOffline(sceneThis, page);
                    }, "void", ["pointer", "int", "bool", "pointer"])));

                    log("[+] Interceptor.replace installed on CardBookScene main view functions!");
                } catch (eCbMainHooks) {
                    log("[-] Error installing CardBook main hooks: " + eCbMainHooks.message);
                }

                // 3f. CardBookControl.GetGroupItem (0x11C83DC) & GetMajorGroupItem (0x11C8528) -> Dynamic group return
                try {
                    Interceptor.replace(baseAddr.add(0x11C83DC), new NativeCallback(function (groupList, groupCode, methodInfo) {
                        if (allCbGroupItemMap[groupCode]) return allCbGroupItemMap[groupCode];
                        return cachedLoonaCbGroupItem || NULL;
                    }, "pointer", ["pointer", "int", "pointer"]));
                    Interceptor.replace(baseAddr.add(0x11C8528), new NativeCallback(function (groupList, groupCode, methodInfo) {
                        if (allCbGroupItemMap[groupCode]) return allCbGroupItemMap[groupCode];
                        return cachedLoonaCbGroupItem || NULL;
                    }, "pointer", ["pointer", "int", "pointer"]));
                    log("[+] Interceptor.replace installed on CardBookControl.GetGroupItem & GetMajorGroupItem!");
                } catch (eGgi) {
                    log("[-] Error replacing GetGroupItem: " + eGgi.message);
                }


                // 3g. CardBookScene.GetGroupItemOfIndex (0x11D1D60) -> Return group item by index
                try {
                    Interceptor.replace(baseAddr.add(0x11D1D60), new NativeCallback(function (scenePtr, infoPtr, index, methodInfo) {
