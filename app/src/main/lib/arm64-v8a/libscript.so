                        log("[⚡ MATERIAL LIST] Populating materials for target ObjId=" + targetObjKey + ", CardId=" + targetCardId + ", Art=" + targetArtistCode + ", Grade=" + targetGrade + ", Lvl=" + targetLevel + ", isUpgrade=" + isUpgradeMode + ", isRMax=" + isRMax);

