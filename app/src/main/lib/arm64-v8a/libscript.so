                                var extraTheme = args[5].toInt32();
                                log("[🎵 SCORE_DATA] Ingame ScoreData initialized: noteCount=" + nCnt + ", members=" + mCnt + ", diff=" + diff + ", startGradeBonus=" + startGradeBonus + ", extraThemeBonus=" + extraTheme);
                            }
