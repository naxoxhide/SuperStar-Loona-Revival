                            if (profile.equipedCards && profile.equipedCards[gCode.toString()]) {
                                profile.equipedCards[gCode.toString()] = profile.equipedCards[gCode.toString()].filter(function(id) {
                                    return id.toString() !== objId.toString();
                                });
