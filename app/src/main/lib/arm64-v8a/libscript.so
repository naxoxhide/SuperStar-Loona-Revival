                            var sGr = parseInt(subGrade, 10) || 0;
                            var sLvl = Math.max(1, parseInt(subLevel, 10) || 1);

                            var code = (gr < 4) ? (gr * 5 + Math.min(4, lvl - 1)) : (20 + Math.min(98, lvl - 1));
