                            var objIdB = rawB.add(0x10).readS64();
                            var cIdA = rawA.add(0x20).readS32();
                            var cIdB = rawB.add(0x20).readS32();
                            var gA = rawA.add(0x24).readS32();
                            var gB = rawB.add(0x24).readS32();
                            var lA = rawA.add(0x1C).readS16();
                            var lB = rawB.add(0x1C).readS16();

                            if (matSortMode === 2) {
                                if (objIdA.compare(objIdB) !== 0) return objIdB.compare(objIdA);
                                return cIdA - cIdB;
                            }
                            if (offlineFilterGroup) {
                                var metaA = getCardMetadata(cIdA);
                                var metaB = getCardMetadata(cIdB);
                                var grpA = (metaA && (metaA.groupID || metaA.group)) ? (metaA.groupID || metaA.group) : 1001;
                                var grpB = (metaB && (metaB.groupID || metaB.group)) ? (metaB.groupID || metaB.group) : 1001;
                                if (grpA !== grpB) return grpA - grpB;
                                var artA = (metaA && metaA.artistID) ? metaA.artistID : cIdA;
                                var artB = (metaB && metaB.artistID) ? metaB.artistID : cIdB;
                                if (artA !== artB) return artA - artB;
                            }
                            if (matSortMode === 1) {
                                if (gA !== gB) return gB - gA;
                                if (lA !== lB) return lB - lA;
                                return cIdA - cIdB;
                            }
                            if (gA !== gB) return gA - gB;
                            if (lA !== lB) return lA - lB;
                            return cIdA - cIdB;
                        });

                        log("[⚡ MATERIAL LIST] Found " + eligible.length + " eligible material cards (matSortMode=" + matSortMode + ")!");

                        var listItems = ensureListBuffer(dclPtr, Math.max(eligible.length, 64));
                        for (var j = 0; j < eligible.length; j++) {
                            listItems.add(0x20 + j * 8).writePointer(eligible[j]);
                        }
                        dclPtr.add(0x18).writeS32(eligible.length);
                        sceneThis.add(0x50).writeS32(2); // EXTRACT_TYPE.Material

                        // Refresh UI CardView
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (!sceneView.isNull()) {
                            var cardView = sceneView.add(0x78).readPointer();
                            if (!cardView.isNull()) {
                                var eventListener = ensureCardViewEventListener(sceneThis, cardView);
                                var setDataFn = new NativeFunction(baseAddr.add(0xF23384), "void", ["pointer", "int", "bool", "pointer", "pointer"]);
                                setDataFn(cardView, eligible.length, 0, eventListener, NULL);
                                sanitizeCardScroller(cardView);
                                try {
                                    var scroller = cardView.add(0x40).readPointer();
                                    if (!scroller.isNull()) {
                                        var getGoFnBase = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                                        var setActFnBase = new NativeFunction(baseAddr.add(0x1DBADF4), "void", ["pointer", "bool", "pointer"]);
                                        var acv = scroller.add(0x120).readPointer();
                                        if (!acv.isNull()) {
                                            var acvCount = acv.add(0x18).readS32();
                                            var acvData = acv.add(0x10).readPointer();
                                            for (var cIdx = 0; cIdx < acvCount; cIdx++) {
                                                var cCell = acvData.add(0x20 + cIdx * 8).readPointer();
                                                if (cCell.isNull()) continue;
                                                var dIdx = cIdx;
                                                cCell.add(0x24).writeS32(dIdx);
                                                var cGo = getGoFnBase(cCell, NULL);
                                                if (!cGo.isNull()) {
                                                    try {
                                                        var setNameFn = new NativeFunction(baseAddr.add(0x1DC7698), "void", ["pointer", "pointer", "pointer"]);
                                                        setNameFn(cGo, createIl2CppString(dIdx.toString()), NULL);
                                                    } catch (eSn) {}
                                                }
                                                if (dIdx >= 0 && dIdx < eligible.length) {
                                                    if (!cGo.isNull()) setActFnBase(cGo, 1, NULL);
                                                    updateSingleCell(cCell, eligible[dIdx], dIdx, false);
                                                } else {
                                                    if (!cGo.isNull()) setActFnBase(cGo, 0, NULL);
                                                }
                                            }
                                        }
                                    }
                                } catch (eMatCells) {
                                    log("[-] Error updating material carousel cells: " + eMatCells.message);
                                }
                                var cardCountText = cardView.add(0x38).readPointer();
                                if (!cardCountText.isNull()) {
                                    var setTextFn = new NativeFunction(baseAddr.add(0x21A5FC4), "void", ["pointer", "pointer", "pointer"]);
                                    setTextFn(cardCountText, createIl2CppString(eligible.length + " / 200"), NULL);
                                    log("[📊 CARD COUNT] Updated intensify count text to: " + eligible.length + " / 200");
                                }
                            }
                        }
                        log("[✅ MATERIAL LIST] Material display list refreshed in UI with " + eligible.length + " cards!");
                    } catch (eMatList) {
                        log("[-] Error in populateMaterialDisplayCardList: " + eMatList.message);
                    }
                };

                // Global cached pedestal watermark sprite (translucent official SUPER STAR LOONA watermark)
                var globalWatermarkSprite = null;
                var getWatermarkSprite = function() {
                    if (globalWatermarkSprite && !globalWatermarkSprite.isNull()) {
                        try {
                            var testPtr = globalWatermarkSprite.add(0x10).readPointer();
                            if (!testPtr.isNull()) return globalWatermarkSprite;
                        } catch (eTest) {}
                        globalWatermarkSprite = null;
                    }
                    try {
                        var wmTex = loadLocalTexture2D("asiudgasg/pedestal_watermark.png");
                        if (wmTex && !wmTex.isNull()) {
                            var createSpriteFn = new NativeFunction(baseAddr.add(0x23E1268), "pointer", ["pointer", "pointer"]);
                            var sp = createSpriteFn(wmTex, NULL);
                            if (sp && !sp.isNull()) {
                                if (il2cpp_gchandle_new) il2cpp_gchandle_new(sp, 2); // Pinned GC handle
                                var dontDestroyFn = new NativeFunction(baseAddr.add(0x1DC7FB4), "void", ["pointer", "pointer"]);
                                dontDestroyFn(sp, NULL);
                                globalWatermarkSprite = sp;
                                log("[🏛️ WATERMARK] Created & pinned global watermark sprite: " + sp);
                                return sp;
                            } else {
                                log("[-] CreateSprite returned null for pedestal_watermark.png");
                            }
                        } else {
                            log("[-] loadLocalTexture2D returned null for pedestal_watermark.png");
                        }
                    } catch (eWsp) {
                        log("[-] Error in getWatermarkSprite: " + eWsp.message);
                    }
                    return NULL;
                };

                // Visual & state refresh for InvenCardIntensifyView (5 pedestals + probability + RP price)
                var safeRefreshIntensifyView = function(sceneThis) {
                    try {
                        if (!sceneThis || sceneThis.isNull()) return;
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (!sceneView || sceneView.isNull()) return;
                        var intensifyView = sceneView.add(0x68).readPointer();
                        if (!intensifyView || intensifyView.isNull()) return;

                        var matListObj = intensifyView.add(0x40).readPointer();
                        if (!matListObj || matListObj.isNull()) return;
                        var matCount = matListObj.add(0x18).readS32();
                        var matItems = matListObj.add(0x10).readPointer();

                        // Read registered material cards from sceneThis.materialCardItemList (0xA0)
                        var regMatList = sceneThis.add(0xA0).readPointer();
                        var regCards = [];
                        if (!regMatList.isNull()) {
                            var regCount = regMatList.add(0x18).readS32();
                            var regItems = regMatList.add(0x10).readPointer();
                            if (!regItems.isNull()) {
                                for (var r = 0; r < regCount; r++) {
                                    var cItem = regItems.add(0x20 + r * 8).readPointer();
                                    if (!cItem.isNull()) regCards.push(cItem);
                                }
                            }
                        }

                        // Target card
                        var tCard = sceneThis.add(0x88).readPointer();
                        if (tCard.isNull()) tCard = sceneThis.add(0x98).readPointer();
                        var tGrade = 0, tLvl = 1;
                        if (!tCard.isNull()) {
                            var tRaw = tCard.add(0x10).readPointer();
                            if (!tRaw.isNull()) {
                                tGrade = tRaw.add(0x24).readS32();
                                tLvl = tRaw.add(0x1C).readS16();
                            }
                        }

                        var setActiveFn = new NativeFunction(baseAddr.add(0x1DBADF4), "void", ["pointer", "bool", "pointer"]);
                        var getGameObjectFn = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                        var cardRefreshFn = new NativeFunction(baseAddr.add(0x137F570), "void", ["pointer", "pointer", "pointer"]);
                        var setTextFn = new NativeFunction(baseAddr.add(0x21A5FC4), "void", ["pointer", "pointer", "pointer"]);
                        var setFlowTextFn = new NativeFunction(baseAddr.add(0xD356FC), "void", ["pointer", "pointer", "pointer"]);
                        var setBtnTextFn = new NativeFunction(baseAddr.add(0xE9B7B0), "void", ["pointer", "pointer", "pointer"]);
                        var setTextureFn = new NativeFunction(baseAddr.add(0x194C074), "void", ["pointer", "pointer", "pointer"]);
                        var setPhotoVisFn = new NativeFunction(baseAddr.add(0x138F3A0), "void", ["pointer", "int", "pointer"]);
                        var setTierVisFn = new NativeFunction(baseAddr.add(0x1393AAC), "void", ["pointer", "int", "pointer"]);
                        var setStarVisFn = new NativeFunction(baseAddr.add(0x1388C58), "void", ["pointer", "int", "pointer"]);
                        var setNumVisFn = new NativeFunction(baseAddr.add(0x1393D68), "void", ["pointer", "int", "pointer"]);
                        var setValFn = new NativeFunction(baseAddr.add(0xC10448), "void", ["pointer", "uint32", "pointer"]);
                        var getRectTrFn = new NativeFunction(baseAddr.add(0x1614EF0), "pointer", ["pointer", "pointer"]);
                        var setSizeDeltaFn = new NativeFunction(baseAddr.add(0x180DC18), "void", ["pointer", "float", "float", "pointer"]);
                        var setNativeSizeFn = new NativeFunction(baseAddr.add(0x194C1C8), "void", ["pointer", "pointer"]);
                        var setEnabledFn = new NativeFunction(baseAddr.add(0x1DB3CFC), "void", ["pointer", "int", "pointer"]);

                        var isMaxLevel = (tLvl >= getMaxCardLevel(tGrade));
                        var isUpgradeMode = (tGrade < 4 && isMaxLevel);
                        var isRMax = (tGrade === 4 && isMaxLevel);

                        // 1. Header text (intensifyView + 0x38)
                        var headerTextObj = intensifyView.add(0x38).readPointer();
                        if (!headerTextObj.isNull()) {
                            try { setTextFn(headerTextObj, createIl2CppString(isUpgradeMode ? "Upgrade Material" : "Material Card"), NULL); } catch (eHdr) {}
                        }

                        // 2. Probability Header text (intensifyView + 0x48)
                        var probHdrObj = intensifyView.add(0x48).readPointer();
                        if (!probHdrObj.isNull()) {
                            try {
                                var pHdrStr = isRMax ? "MAX Level Reached: " :
                                              isUpgradeMode ? "Upgrade Success Chance: " :
                                              (tGrade === 4) ? "Level Up Success Chance: " : "Power Up Success Chance: ";
                                setTextFn(probHdrObj, createIl2CppString(pHdrStr), NULL);
                            } catch (ePh) {}
                        }

                        var totalPrice = 0;
                        var failureProbProduct = 1.0;

                        for (var i = 0; i < matCount; i++) {
                            var matView = matItems.add(0x20 + i * 8).readPointer();
                            if (!matView || matView.isNull()) continue;

                            var emptyImg = matView.add(0x38).readPointer();
                            var effectGo = matView.add(0x40).readPointer();
                            var enabledGo = matView.add(0x48).readPointer();
                            var artistFlowName = matView.add(0x50).readPointer();
                            var cardSmall = matView.add(0x58).readPointer();
                            var mountGo = matView.add(0x60).readPointer();

                            if (i < regCards.length) {
                                var cardItem = regCards[i];
                                var raw = cardItem.add(0x10).readPointer();
                                var cId = raw.add(0x20).readS32();
                                var gr = raw.add(0x24).readS32();
                                var lvl = raw.add(0x1C).readS16();
                                var isMatPrism = (raw.add(0x2A).readU8() === 1);

                                var info = getIntensifyPriceAndRate(tGrade, tLvl, gr, lvl);
                                totalPrice += info.price;
                                var singleRate = Math.min(100.0, Math.max(0.0, info.rate)) / 100.0;
                                failureProbProduct *= (1.0 - singleRate);

                                // Refresh CardSmallView via createMockSmallCardParams with real isPrism flag
                                try {
                                    var cardParam = createMockSmallCardParams(cId, gr, lvl, isMatPrism);
                                    if (cardParam && !cardParam.isNull()) {
                                        cardRefreshFn(cardSmall, cardParam, NULL);
                                    }
                                } catch (eCrf) {
                                    log("[-] Error refreshing cardSmall: " + eCrf.message);
                                }

                                // Direct texture injection, GameObject activation & size calibration (matching updateSingleCell)
                                try {
                                    var photoRawImg = cardSmall.add(0x58).readPointer();
                                    if (!photoRawImg.isNull()) {
                                        var photoTex = loadLocalTexture2D("asiudgasg/asodhsg/wadceg/" + cId + "_l.i.bytes") ||
                                                       loadLocalTexture2D("asiudgasg/asodhsg/wadceg/" + cId + "_s.i.bytes");
                                        if (photoTex && !photoTex.isNull()) {
                                            setTextureFn(photoRawImg, photoTex, NULL);
                                            cardSmall.add(0x50).writePointer(photoTex);
                                            setEnabledFn(photoRawImg, 1, NULL);
                                            var pGo = getGameObjectFn(photoRawImg, NULL);
                                            if (!pGo.isNull()) setActiveFn(pGo, 1, NULL);
                                            var photoRectTr = getRectTrFn(photoRawImg, NULL);
                                            if (!photoRectTr.isNull()) {
                                                setSizeDeltaFn(photoRectTr, 92.0, 130.0, NULL);
                                            }
                                        }
                                    }
                                    var tierRawImg = cardSmall.add(0x68).readPointer();
                                    if (!tierRawImg.isNull()) {
                                        var gLetter = (gr === 4) ? "r" : (gr === 3) ? "s" : (gr === 2) ? "a" : (gr === 1) ? "b" : "c";
                                        var tierRelPath = (gr === 1) ? "0b_s.i.bytes" : ("0_" + gLetter + "_s.i.bytes");
                                        var tierTex = loadLocalTexture2D("asiudgasg/asodhsg/aoeiwhslc/uhex/" + tierRelPath) ||
                                                      loadLocalTexture2D("asiudgasg/asodhsg/aoeiwhslc/uhex/0_" + gLetter + "_s.i.bytes");
                                        if (tierTex && !tierTex.isNull()) {
                                            setTextureFn(tierRawImg, tierTex, NULL);
                                            cardSmall.add(0x60).writePointer(tierTex);
                                            setEnabledFn(tierRawImg, 1, NULL);
                                            var tGo = getGameObjectFn(tierRawImg, NULL);
                                            if (!tGo.isNull()) setActiveFn(tGo, 1, NULL);
                                            setNativeSizeFn(tierRawImg, NULL);
                                        }
                                    }
                                    setPhotoVisFn(cardSmall, 1, NULL);
                                    setTierVisFn(cardSmall, 1, NULL);

                                    // Level Stars vs Number
                                    if (gr === 4) {
                                        setStarVisFn(cardSmall, 0, NULL);
                                        setNumVisFn(cardSmall, 1, NULL);
                                        var numBox = cardSmall.add(0x80).readPointer();
                                        if (!numBox.isNull()) setValFn(numBox, lvl, NULL);
                                    } else {
                                        setStarVisFn(cardSmall, 1, NULL);
                                        setNumVisFn(cardSmall, 0, NULL);
                                    }

                                    // Hide ImageEfftect (0xC8) and mark (0xC0) on pedestal card
                                    var imgEff = cardSmall.add(0xC8).readPointer();
                                    if (!imgEff.isNull()) {
                                        setEnabledFn(imgEff, 0, NULL);
                                        var effG = getGameObjectFn(imgEff, NULL);
                                        if (!effG.isNull()) setActiveFn(effG, 0, NULL);
                                    }
                                    var markImg = cardSmall.add(0xC0).readPointer();
                                    if (!markImg.isNull()) {
                                        setEnabledFn(markImg, 0, NULL);
                                        var mG = getGameObjectFn(markImg, NULL);
                                        if (!mG.isNull()) setActiveFn(mG, 0, NULL);
                                    }
                                } catch (eTex) {
                                    log("[-] Error injecting pedestal textures: " + eTex.message);
                                }

                                // Artist FlowTitle marquee (matView + 0x50)
                                if (!artistFlowName.isNull()) {
                                    try {
                                        var afGo = getGameObjectFn(artistFlowName, NULL);
                                        if (!afGo.isNull()) setActiveFn(afGo, 1, NULL);
                                        var cMeta = getCardMetadata(cId);
                                        var mAId = (cMeta && cMeta.artistID) ? cMeta.artistID : 0;
                                        var mArtistMeta = (mAId > 0) ? getArtistMetadata(mAId) : null;
                                        var mArtistName = (mArtistMeta && mArtistMeta.name && mArtistMeta.name !== ("Artist " + mAId))
                                            ? mArtistMeta.name
                                            : (artistNamesMap[mAId] || "LOONA");
                                        setFlowTextFn(artistFlowName, createIl2CppString(mArtistName), NULL);
                                    } catch (eAf) {}
                                }

                                if (!mountGo.isNull()) setActiveFn(mountGo, 1, NULL);
                                if (!effectGo.isNull()) setActiveFn(effectGo, 1, NULL);
                                if (!emptyImg.isNull()) {
                                    var eGo = getGameObjectFn(emptyImg, NULL);
                                    if (!eGo.isNull()) setActiveFn(eGo, 0, NULL);
                                }
                                if (!enabledGo.isNull()) setActiveFn(enabledGo, 0, NULL);
                                if (!cardSmall.isNull()) {
                                    var csGo = getGameObjectFn(cardSmall, NULL);
                                    if (!csGo.isNull()) setActiveFn(csGo, 1, NULL);
                                }
                                log("[🏛️ PEDESTAL " + i + "] Filled with CardID=" + cId + ", Gr=" + gr + ", Lvl=" + lvl + ", Prism=" + isMatPrism + " (Rate=" + info.rate.toFixed(1) + "%, Price=" + info.price + " RP)");
                            } else {
                                var isSlotAvail = !isRMax && (!isUpgradeMode || i === 0);
                                if (!mountGo.isNull()) setActiveFn(mountGo, 0, NULL);
                                if (!effectGo.isNull()) setActiveFn(effectGo, 0, NULL);
                                if (!enabledGo.isNull()) setActiveFn(enabledGo, isSlotAvail ? 1 : 0, NULL);
                                if (!artistFlowName.isNull()) {
                                    var afGoEmpty = getGameObjectFn(artistFlowName, NULL);
                                    if (!afGoEmpty.isNull()) setActiveFn(afGoEmpty, 0, NULL);
                                }
                                if (!emptyImg.isNull()) {
                                    var eGo = getGameObjectFn(emptyImg, NULL);
                                    if (!eGo.isNull()) setActiveFn(eGo, 1, NULL);
                                    setEnabledFn(emptyImg, 1, NULL);
                                    // Calibrate emptyImg RectTransform to cover full slot (100x180 at pos 0,0)
                                    try {
                                        var eRect = getRectTrFn(emptyImg, NULL);
                                        if (!eRect.isNull()) {
                                            setSizeDeltaFn(eRect, 100.0, 180.0, NULL);
                                            var setAnchoredPosFn = new NativeFunction(baseAddr.add(0x180DACC), "void", ["pointer", "float", "float", "pointer"]);
                                            setAnchoredPosFn(eRect, 0.0, 0.0, NULL);
                                        }
                                    } catch (eERect) {}
                                    // Official SUPER STAR LOONA watermark texture styling (dimmed if slot unavailable)
                                    try {
                                        var setSpriteFn = new NativeFunction(baseAddr.add(0x1ECB61C), "void", ["pointer", "pointer", "pointer"]);
                                        var wmSprite = getWatermarkSprite();
                                        if (wmSprite && !wmSprite.isNull()) {
                                            setSpriteFn(emptyImg, wmSprite, NULL);
                                            emptyImg.add(0x20).writeFloat(1.0);
                                            emptyImg.add(0x24).writeFloat(1.0);
                                            emptyImg.add(0x28).writeFloat(1.0);
                                            emptyImg.add(0x2C).writeFloat(isSlotAvail ? 1.0 : 0.35);
                                        } else {
                                            // Transparent fallback to prevent opaque white box if sprite is unavailable
                                            emptyImg.add(0x2C).writeFloat(0.0);
                                        }
                                        // Force CanvasRenderer to re-upload mesh and material
                                        var setVertsDirtyFn = new NativeFunction(baseAddr.add(0x1614F4C), "void", ["pointer", "pointer"]);
                                        setVertsDirtyFn(emptyImg, NULL);
                                        var setMatDirtyFn = new NativeFunction(baseAddr.add(0x1614FE4), "void", ["pointer", "pointer"]);
                                        setMatDirtyFn(emptyImg, NULL);
                                    } catch (eEmpCol) {
                                        log("[-] Error setting pedestal watermark: " + eEmpCol.message);
                                    }
                                }
                                if (!cardSmall.isNull()) {
                                    var csGo = getGameObjectFn(cardSmall, NULL);
                                    if (!csGo.isNull()) setActiveFn(csGo, 0, NULL);
                                }
                            }
                        }

                        var totalProbRate = (regCards.length > 0) ? (isUpgradeMode ? 100.0 : (1.0 - failureProbProduct) * 100.0) : 0.0;
                        var probLabel = "Normal";
                        var probColor = { r: 0.96, g: 0.64, b: 0.38, a: 1.0 }; // Amber
                        if (isRMax) {
                            probLabel = "MAX";
                            probColor = { r: 0.88, g: 0.19, b: 0.47, a: 1.0 };
                        } else if (isUpgradeMode && regCards.length > 0) {
                            probLabel = "100%";
                            probColor = { r: 0.88, g: 0.19, b: 0.47, a: 1.0 };
                        } else if (totalProbRate >= 50.0) {
                            probLabel = "High";
                            probColor = { r: 0.88, g: 0.19, b: 0.47, a: 1.0 }; // Magenta / Pink (#E03177)
                        } else if (totalProbRate >= 25.0) {
                            probLabel = "Normal";
                            probColor = { r: 0.96, g: 0.64, b: 0.38, a: 1.0 }; // Amber
                        } else if (totalProbRate > 0.0) {
                            probLabel = "Low";
                            probColor = { r: 0.90, g: 0.32, b: 0.35, a: 1.0 }; // Coral / Red
                        }

                        var probTextObj = intensifyView.add(0x50).readPointer();
                        if (!probTextObj.isNull()) {
                            var pStr = (isRMax || regCards.length > 0) ? probLabel : "-";
                            setTextFn(probTextObj, createIl2CppString(pStr), NULL);
                            try {
                                if (isRMax || regCards.length > 0) {
                                    probTextObj.add(0x20).writeFloat(probColor.r);
                                    probTextObj.add(0x24).writeFloat(probColor.g);
                                    probTextObj.add(0x28).writeFloat(probColor.b);
                                    probTextObj.add(0x2C).writeFloat(probColor.a);
                                }
                            } catch (ePCol) {}
                        }

                        // Button labels & states: btnRecommend (0x58), btnTry (0x60), btnTryEvent (0x68), btnDisable (0x78)
                        var btnRecommend = intensifyView.add(0x58).readPointer();
                        if (!btnRecommend.isNull()) {
                            try { setBtnTextFn(btnRecommend, createIl2CppString("Recommended\nMaterial"), NULL); } catch (eBr) {}
                        }

                        // Ensure btnTryEvent (0x68) is deactivated via legitimate GameObject to prevent ghost 'TrY' text overlay
                        var btnTryEvent = intensifyView.add(0x68).readPointer();
                        if (!btnTryEvent.isNull()) {
                            try {
                                var tryEvGo = getGameObjectFn(btnTryEvent, NULL);
                                if (!tryEvGo.isNull()) setActiveFn(tryEvGo, 0, NULL);
                                var tryEvSubBtn = btnTryEvent.add(0x38).readPointer();
                                if (!tryEvSubBtn.isNull()) {
                                    var subGo = tryEvSubBtn.add(0x10).readPointer();
                                    if (!subGo.isNull()) setActiveFn(subGo, 0, NULL);
                                }
                            } catch (eBte) {
                                log("[-] Error deactivating btnTryEvent: " + eBte.message);
                            }
                        }

                        var btnTry = intensifyView.add(0x60).readPointer();
                        var btnDisable = intensifyView.add(0x78).readPointer();
                        var setPriceFn = new NativeFunction(baseAddr.add(0xE9B914), "void", ["pointer", "pointer", "pointer"]);

                        var formattedPrice = (totalPrice > 0) ? totalPrice.toLocaleString("en-US") : "0";
                        var il2cppPriceStr = createIl2CppString(formattedPrice);
                        var tryActionLabel = isRMax ? "MAX" : (isUpgradeMode ? "UPGRADE" : "TRY");
                        var il2cppTryLabel = createIl2CppString(tryActionLabel);
                        var canTry = (!isRMax && regCards.length > 0);

                        if (!btnTry.isNull()) {
                            try { setBtnTextFn(btnTry, il2cppTryLabel, NULL); } catch (eBtL) {}
                            try { setPriceFn(btnTry, il2cppPriceStr, NULL); } catch (ePt) {}
                            var tryGo = btnTry.add(0x10).readPointer();
                            if (!tryGo.isNull()) setActiveFn(tryGo, canTry ? 1 : 0, NULL);
                        }
                        if (!btnDisable.isNull()) {
                            try { setBtnTextFn(btnDisable, il2cppTryLabel, NULL); } catch (eBdL) {}
                            try { setPriceFn(btnDisable, il2cppPriceStr, NULL); } catch (ePd) {}
                            var disGo = btnDisable.add(0x10).readPointer();
                            if (!disGo.isNull()) setActiveFn(disGo, canTry ? 0 : 1, NULL);
                        }

                        // Write to InventoryScene fields for native OnIntensifyTry / IntensifyAssist
                        sceneThis.add(0xA8).writeDouble(1.0); // probabilityRate multiplier = 1.0
                        sceneThis.add(0xB0).writeDouble(1.0); // priceRate = 1.0
                        sceneThis.add(0xB8).writeS32(totalPrice);

                        // Ensure InvenCardSelectView (target card view on the left) has complete visuals (frame, photo, badge)
                        try {
                            var svPtr = sceneThis.add(0x48).readPointer();
                            if (!svPtr.isNull()) {
                                var selV = svPtr.add(0x48).readPointer();
                                if (!selV.isNull()) {
                                    safeRefreshInvenCardSelectView(selV, NULL);
                                }
                            }
                        } catch (eSelR) {}

                        log("[🎉 INTENSIFY VIEW REFRESHED] RegCount=" + regCards.length + ", Prob=" + totalProbRate.toFixed(1) + "% (" + probLabel + "), TotalPrice=" + totalPrice + " RP");
                    } catch (eSriv) {
                        log("[-] Error in safeRefreshIntensifyView: " + eSriv.message);
                    }
                };

                // Safe offline entry into intensify mode
                var triggerSafeOnIntensify = function(sceneThis) {
                    try {
                        log("[⚡ ON_INTENSIFY] Starting safe offline intensify mode transition on scene: " + sceneThis);
                        if (!sceneThis || sceneThis.isNull()) return;
                        activeInventorySceneInstance = sceneThis;
                        offlineMaterialSortActive = false;
                        ensureInventoryLists(sceneThis);

                        var tCard = sceneThis.add(0x88).readPointer();
                        if (tCard.isNull()) tCard = sceneThis.add(0x98).readPointer();
                        if (tCard.isNull()) {
                            log("[-] OnIntensify: targetCard is null!");
                            return;
                        }
                        sceneThis.add(0x88).writePointer(tCard);
                        sceneThis.add(0x98).writePointer(tCard);

                        var cId = 1001, gr = 0, lvl = 1;
                        var isPrismTarget = false;
                        var raw = tCard.add(0x10).readPointer();
                        if (!raw.isNull()) {
                            cId = raw.add(0x20).readS32();
                            var ccd = getOrCreateCardControlData(cId);
                            tCard.add(0x18).writePointer(ccd || NULL);
                            gr = raw.add(0x24).readS32();
                            lvl = raw.add(0x1C).readS16();
                            isPrismTarget = (raw.add(0x2A).readU8() === 1);
                            var code = getIntensifyCode(gr, lvl);
                            tCard.add(0x20).writeS16(code);
                            var meta = getCardMetadata(cId);
                            var artistData = resolveArtistDataForCard(meta, cId);
                            if (artistData && !artistData.isNull()) {
                                sceneThis.add(0x80).writePointer(artistData);
                            }
                        }

                        // Event rates default to 1.0
                        sceneThis.add(0xA8).writeDouble(1.0);
                        sceneThis.add(0xB0).writeDouble(1.0);

                        // Clear material list safely
                        var matList = sceneThis.add(0xA0).readPointer();
                        if (!matList.isNull()) {
                            var count = matList.add(0x18).readS32();
                            var items = matList.add(0x10).readPointer();
                            if (!items.isNull()) {
                                for (var m = 0; m < count; m++) {
                                    var it = items.add(0x20 + m * 8).readPointer();
                                    if (!it.isNull()) it.add(0x2C).writeU8(0);
                                }
                            }
                            matList.add(0x18).writeS32(0);
                        }

                        // Switch state to 8 (STATE.Intensify)
                        sceneThis.add(0x24).writeS32(8);

                        // Show Intensify Layout
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (!sceneView.isNull()) {
                            safeShowIntensifyLayout(sceneView);

                            // Apply large card visuals & tier frame/level to selectView.card (left target card)
                            var selectView = sceneView.add(0x48).readPointer();
                            if (!selectView.isNull()) {
                                var sCard = selectView.add(0x38).readPointer();
                                if (!sCard.isNull()) {
                                    applyCardLargeVisuals(sCard, cId, gr, isPrismTarget, lvl);
                                    if (gr === 4) {
                                        try {
                                            var numLevel = sCard.add(0x80).readPointer();
                                            if (!numLevel.isNull()) {
                                                var setValFn = new NativeFunction(baseAddr.add(0xC10448), "void", ["pointer", "uint32", "pointer"]);
                                                setValFn(numLevel, lvl, NULL);
                                            }
                                        } catch (eNum) {}
                                    }
                                    log("[🖼️ INTENSIFY TARGET] Applied large card visuals to selectView.card for cId=" + cId + " gr=" + gr + " lvl=" + lvl + " prism=" + isPrismTarget);
                                }
                            }
                        }

                        // Refresh Intensify View (5 pedestals, probability, RP price)
                        safeRefreshIntensifyView(sceneThis);

                        // Populate bottom material card list
                        populateMaterialDisplayCardList(sceneThis);
                        log("[🎉 ON_INTENSIFY] Intensify mode opened cleanly!");
                    } catch (eOnInt) {
                        log("[-] Error in safe OnIntensify: " + eOnInt.message);
                    }
                };

                // Smart recommend material selection: picks up to N (1 for Upgrade, default 5 for Power Up) lowest grade eligible cards
                var executeRecommend = function(sceneThis, maxCountOverride) {
                    try {
                        var requestedMax = (typeof maxCountOverride === 'number' && maxCountOverride > 0) ? maxCountOverride : 5;
                        log("[⚡ RECOMMEND EXEC] Starting smart recommend material selection...");
                        if (!sceneThis || sceneThis.isNull()) return;

                        // 1. Clear existing materials
                        var clearFn = new NativeFunction(baseAddr.add(0x1054118), "void", ["pointer"]);
                        clearFn(sceneThis);

                        // 2. Identify target card
                        var targetCard = sceneThis.add(0x88).readPointer();
                        if (targetCard.isNull()) targetCard = sceneThis.add(0x98).readPointer();
                        if (!targetCard.isNull()) {
                            sceneThis.add(0x88).writePointer(targetCard);
                            sceneThis.add(0x98).writePointer(targetCard);
                        }
                        var targetObjId = 0;
                        var targetGrade = 0;
                        var targetLevel = 1;
                        var targetCardId = 0;
                        var targetArtistCode = 0;
                        var tMeta = null;
                        if (!targetCard.isNull()) {
                            var rawT = targetCard.add(0x10).readPointer();
                            if (!rawT.isNull()) {
                                targetObjId = rawT.add(0x10).readS64();
                                targetGrade = rawT.add(0x24).readS32();
                                targetLevel = rawT.add(0x1C).readS16();
                                targetCardId = rawT.add(0x20).readS32();
                                tMeta = getCardMetadata(targetCardId);
                                targetArtistCode = tMeta ? tMeta.artistID : 0;
                            }
                        }
                        var targetObjKey = objIdKey(targetObjId);
                        var isRMax = (targetGrade === 4 && targetLevel >= getMaxCardLevel(4));
                        var isUpgradeMode = (targetGrade < 4 && targetLevel >= 5);
                        var targetMax = isRMax ? 0 : (isUpgradeMode ? 1 : requestedMax);

                        // 3. Find candidates from loonaCardItems
                        var candidates = [];
                        if (!isRMax) {
                            for (var i = 0; i < loonaCardItems.length; i++) {
                                var item = loonaCardItems[i];
                                if (!item || item.isNull() || item.equals(targetCard)) continue;
                                var raw = item.add(0x10).readPointer();
                                if (!raw || raw.isNull()) continue;

                                var objId = raw.add(0x10).readS64();
                                if (objIdKey(objId) === targetObjKey) continue;
                                var isEq = (raw.add(0x28).readU8() !== 0);
                                var isLk = (raw.add(0x29).readU8() !== 0);
                                if (isEq || isLk) continue;

                                var gr = raw.add(0x24).readS32();
                                var lvl = raw.add(0x1C).readS16();
                                var cId = raw.add(0x20).readS32();
                                var cMeta = getCardMetadata(cId);
                                var art = cMeta ? cMeta.artistID : 0;
                                var rateInfo = getIntensifyPriceAndRate(targetGrade, targetLevel, gr, lvl);
                                if (rateInfo.disabled) continue;

                                // Ensure valid IntensifyCode and Card backing field
                                var fCode = getIntensifyCode(gr, lvl);
                                item.add(0x20).writeS16(fCode);
                                var ccd = getOrCreateCardControlData(cId);
                                item.add(0x18).writePointer(ccd || NULL);

                                if (isUpgradeMode) {
                                    if (art === targetArtistCode && gr === targetGrade && lvl >= 5) {
                                        candidates.push(item);
                                    }
                                } else {
                                    candidates.push(item);
                                }
                            }
                        }

                        // 4. Sort lowest grade first (C -> B -> A -> S -> R)
                        candidates.sort(function(a, b) {
                            var rA = a.add(0x10).readPointer();
                            var rB = b.add(0x10).readPointer();
                            var gA = rA.add(0x24).readS32();
                            var gB = rB.add(0x24).readS32();
                            if (gA !== gB) return gA - gB;
                            var lA = rA.add(0x1C).readS16();
                            var lB = rB.add(0x1C).readS16();
                            return lA - lB;
                        });

                        // 5. Ensure targetCard has valid Card backing field, IntensifyCode, and scene.selectedArtistData
                        if (!targetCard.isNull()) {
                            sceneThis.add(0x88).writePointer(targetCard);
                            sceneThis.add(0x98).writePointer(targetCard);
                            var rawT2 = targetCard.add(0x10).readPointer();
                            if (!rawT2.isNull()) {
                                var tCardId2 = rawT2.add(0x20).readS32();
                                var tCcd2 = getOrCreateCardControlData(tCardId2);
                                targetCard.add(0x18).writePointer(tCcd2 || NULL);
                                var tCode2 = getIntensifyCode(targetGrade, targetLevel);
                                targetCard.add(0x20).writeS16(tCode2);
                            }
                        }
                        if (targetCardId > 0) {
                            var resolvedArt = resolveArtistDataForCard(tMeta, targetCardId);
                            if (resolvedArt && !resolvedArt.isNull()) {
                                sceneThis.add(0x80).writePointer(resolvedArt);
                            }
                        }

                        // 6. Register up to targetMax material cards
                        var pickCount = Math.min(targetMax, candidates.length);
                        var regFn = new NativeFunction(baseAddr.add(0x1056B5C), "void", ["pointer", "pointer"]);
                        for (var p = 0; p < pickCount; p++) {
                            var cand = candidates[p];
                            var cRaw = cand.add(0x10).readPointer();
                            var candCId = cRaw.add(0x20).readS32();
                            var candCcd = getOrCreateCardControlData(candCId);
                            cand.add(0x18).writePointer(candCcd || NULL);
                            var cGr = cRaw.add(0x24).readS32();
                            var cLvl = cRaw.add(0x1C).readS16();
                            var cCode = getIntensifyCode(cGr, cLvl);
                            cand.add(0x20).writeS16(cCode);
                            regFn(sceneThis, cand);
                            log("[⚡ RECOMMEND] Added material card #" + (p + 1) + ": ObjId=" + cRaw.add(0x10).readS64() + ", Grade=" + cGr + ", Level=" + cLvl + ", Code=" + cCode);
                        }

                        // 7. Verify all registered materials in materialCardItemList (scene + 0xA0) have valid Card and IntensifyCode
                        var matList = sceneThis.add(0xA0).readPointer();
                        if (!matList.isNull()) {
                            var mCount = matList.add(0x18).readS32();
                            var mItems = matList.add(0x10).readPointer();
                            for (var m = 0; m < mCount; m++) {
                                var mItem = mItems.add(0x20 + m * 8).readPointer();
                                if (mItem && !mItem.isNull()) {
                                    var mRaw = mItem.add(0x10).readPointer();
                                    if (!mRaw.isNull()) {
                                        var mcId = mRaw.add(0x20).readS32();
                                        var mccd = getOrCreateCardControlData(mcId);
                                        mItem.add(0x18).writePointer(mccd || NULL);
                                        var mgr = mRaw.add(0x24).readS32();
                                        var mlvl = mRaw.add(0x1C).readS16();
                                        var mfCode = getIntensifyCode(mgr, mlvl);
                                        mItem.add(0x20).writeS16(mfCode);
                                    }
                                }
                            }
                        }

                        // 8. Refresh view and play SE audio
                        try {
                            var playSeFn = new NativeFunction(baseAddr.add(0xD0A3B4), "void", ["pointer", "pointer"]);
                            playSeFn(createIl2CppString("cardselect"), NULL);
                        } catch (eSeRec) {}
                        safeRefreshIntensifyView(sceneThis);
                        populateMaterialDisplayCardList(sceneThis);
                        log("[🎉 RECOMMEND COMPLETE] Registered " + pickCount + " material cards and refreshed view successfully!");
                    } catch (eRecExec) {
                        log("[-] Error in executeRecommend: " + eRecExec.message);
                    }
                };

                // Diagnostic: dump real runtime state of InvenCardView (sceneView+0x78), its EnhancedScroller and active cells
                var diagCarousel = function(sceneThis) {
                    try {
                        var dGo = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                        var dTr = new NativeFunction(baseAddr.add(0x1DB6A94), "pointer", ["pointer", "pointer"]);
                        var dActSelf = new NativeFunction(baseAddr.add(0x1DBAE44), "bool", ["pointer", "pointer"]);
                        var dActHier = new NativeFunction(baseAddr.add(0x1DBAE84), "bool", ["pointer", "pointer"]);
                        var dEnabled = new NativeFunction(baseAddr.add(0x1DB3CBC), "bool", ["pointer", "pointer"]);
                        var dRect = new NativeFunction(baseAddr.add(0x180D6E0), ["float", "float", "float", "float"], ["pointer", "pointer"]);
                        var dSize = new NativeFunction(baseAddr.add(0x180DB70), ["float", "float"], ["pointer", "pointer"]);
                        var dScale = new NativeFunction(baseAddr.add(0x181DF78), ["float", "float", "float"], ["pointer", "pointer"]);
                        var dPos = new NativeFunction(baseAddr.add(0x180DE48), ["float", "float", "float"], ["pointer", "pointer"]);
                        var dChildCount = new NativeFunction(baseAddr.add(0x181ECF0), "int", ["pointer", "pointer"]);
                        var dColor = new NativeFunction(baseAddr.add(0x1614760), ["float", "float", "float", "float"], ["pointer", "pointer"]);
                        var dTex = new NativeFunction(baseAddr.add(0x194C06C), "pointer", ["pointer", "pointer"]);
                        var f2 = function(a) { return a.map(function(v) { return v.toFixed(1); }).join(","); };
                        var goInfo = function(comp) {
                            if (!comp || comp.isNull()) return "null";
                            var g = dGo(comp, NULL);
                            if (g.isNull()) return "noGO";
                            return "self=" + dActSelf(g, NULL) + " hier=" + dActHier(g, NULL);
                        };
                        var rtInfo = function(rt) {
                            if (!rt || rt.isNull()) return "null";
                            return "rect=[" + f2(dRect(rt, NULL)) + "] size=[" + f2(dSize(rt, NULL)) + "] pos=[" + f2(dPos(rt, NULL)) + "] scale=[" + f2(dScale(rt, NULL)) + "]";
                        };

                        var sceneView = sceneThis.add(0x48).readPointer();
                        var cardView = sceneView.add(0x78).readPointer();
                        log("[🩺 DIAG] cardView=" + cardView + " GO(" + goInfo(cardView) + ") RT " + rtInfo(dTr(cardView, NULL)));
                        log("[🩺 DIAG] baseSizes bg=[" + cardView.add(0x70).readFloat().toFixed(1) + "," + cardView.add(0x74).readFloat().toFixed(1) +
                            "] list=[" + cardView.add(0x78).readFloat().toFixed(1) + "," + cardView.add(0x7C).readFloat().toFixed(1) +
                            "] bgZero=[" + cardView.add(0x80).readFloat().toFixed(1) + "," + cardView.add(0x84).readFloat().toFixed(1) +
                            "] listZero=[" + cardView.add(0x88).readFloat().toFixed(1) + "," + cardView.add(0x8C).readFloat().toFixed(1) +
                            "] maxCount=" + cardView.add(0x98).readS32() + " showLight=" + cardView.add(0x9C).readU8());
                        var bgObj = cardView.add(0x58).readPointer();
                        var listObj = cardView.add(0x60).readPointer();
                        log("[🩺 DIAG] backgroundObj GO(" + goInfo(bgObj) + ") " + rtInfo(bgObj));
                        log("[🩺 DIAG] ListObj GO(" + goInfo(listObj) + ") " + rtInfo(listObj));

                        var scroller = cardView.add(0x40).readPointer();
                        if (scroller.isNull()) { log("[🩺 DIAG] scroller NULL"); return; }
                        log("[🩺 DIAG] scroller GO(" + goInfo(scroller) + ") enabled=" + dEnabled(scroller, NULL) +
                            " delegate=" + scroller.add(0xD8).readPointer() + " scrollRect=" + scroller.add(0xB0).readPointer() +
                            " reload=" + scroller.add(0xE0).readU8() + " scrollPos=" + scroller.add(0x118).readFloat().toFixed(1) +
                            " active[" + scroller.add(0x128).readS32() + ".." + scroller.add(0x12C).readS32() + "] lastRectSize=" + scroller.add(0x14C).readFloat().toFixed(1));
                        log("[🩺 DIAG] scrollRectTransform " + rtInfo(scroller.add(0xB8).readPointer()));
                        var container = scroller.add(0xC8).readPointer();
                        log("[🩺 DIAG] container GO(" + goInfo(container) + ") children=" + (container.isNull() ? -1 : dChildCount(container, NULL)) + " " + rtInfo(container));
                        if (!container.isNull()) {
                            var dGetChild = new NativeFunction(baseAddr.add(0x181F128), "pointer", ["pointer", "int", "pointer"]);
                            var dName = new NativeFunction(baseAddr.add(0x1DC5A54), "pointer", ["pointer", "pointer"]);
                            var nChild = dChildCount(container, NULL);
                            for (var ch = 0; ch < nChild; ch++) {
                                var cT = dGetChild(container, ch, NULL);
                                if (cT.isNull()) continue;
                                var cNm = "";
                                try { cNm = readIl2CppString(dName(cT, NULL)); } catch (eNm) {}
                                log("[🩺 DIAG]  child[" + ch + "] '" + cNm + "' " + cT + " GO(" + goInfo(cT) + ") " + rtInfo(cT));
                            }
                        }
                        var padF = scroller.add(0xF0).readPointer();
                        var padL = scroller.add(0xF8).readPointer();
                        log("[🩺 DIAG] firstPadder=" + padF + " lastPadder=" + padL + " recycledContainer=" + scroller.add(0x100).readPointer());

                        var acv = scroller.add(0x120).readPointer();
                        var acvCount = acv.isNull() ? 0 : acv.add(0x18).readS32();
                        var acvData = acv.isNull() ? NULL : acv.add(0x10).readPointer();
                        log("[🩺 DIAG] activeCellViews count=" + acvCount);
                        for (var i = 0; i < acvCount && i < 16; i++) {
                            var cell = acvData.add(0x20 + i * 8).readPointer();
                            if (cell.isNull()) continue;
                            var item = cell.add(0x38).readPointer();
                            var lsnr = cell.add(0x50).readPointer();
                            var lsnrTarget = (!lsnr.isNull()) ? lsnr.add(0x10).readPointer() : NULL;
                            var lsnrMethod = (!lsnr.isNull()) ? lsnr.add(0x18).readPointer() : NULL;
                            var lsnrRva = (!lsnrMethod.isNull()) ? " RVA 0x" + lsnrMethod.sub(baseAddr).toString(16) : "";
                            var line = "[🩺 DIAG] cell#" + i + " " + cell + " dataIdx=" + cell.add(0x24).readS32() + " GO(" + goInfo(cell) + ") RT " + rtInfo(dTr(cell, NULL)) +
                                " inst=" + cell.add(0x4C).readU8() + " listener=" + lsnr + "(" + lsnrTarget + "," + lsnrMethod + lsnrRva + ") item=" + item;
                            log(line);
                            if (!item.isNull()) {
                                var photo = item.add(0x58).readPointer();
                                var tier = item.add(0x68).readPointer();
                                var eff = item.add(0xC8).readPointer();
                                log("[🩺 DIAG]    item GO(" + goInfo(item) + ") RT " + rtInfo(dTr(item, NULL)) + " params=" + item.add(0x48).readPointer());
                                if (!photo.isNull()) {
                                    var pTex = dTex(photo, NULL);
                                    var pTexNm = (!pTex.isNull()) ? readIl2CppString(dName(pTex, NULL)) : "null";
                                    log("[🩺 DIAG]    photo GO(" + goInfo(photo) + ") en=" + dEnabled(photo, NULL) + " tex=" + pTex + "('" + pTexNm + "') color=[" + f2(dColor(photo, NULL)) + "] " + rtInfo(dTr(photo, NULL)));
                                }
                                if (!tier.isNull()) {
                                    var tTex = dTex(tier, NULL);
                                    var tTexNm = (!tTex.isNull()) ? readIl2CppString(dName(tTex, NULL)) : "null";
                                    log("[🩺 DIAG]    tier GO(" + goInfo(tier) + ") en=" + dEnabled(tier, NULL) + " tex=" + tTex + "('" + tTexNm + "') color=[" + f2(dColor(tier, NULL)) + "]");
                                }
                                if (!eff.isNull()) log("[🩺 DIAG]    ImageEfftect GO(" + goInfo(eff) + ") en=" + dEnabled(eff, NULL) + " " + rtInfo(dTr(eff, NULL)));
                                var itemTr = dTr(item, NULL);
                                if (!itemTr.isNull()) {
                                    var nItemCh = dChildCount(itemTr, NULL);
                                    for (var ic = 0; ic < nItemCh; ic++) {
                                        var icT = dGetChild(itemTr, ic, NULL);
                                        if (icT.isNull()) continue;
                                        var icNm = "";
                                        try { icNm = readIl2CppString(dName(icT, NULL)); } catch (eIn) {}
                                        log("[🩺 DIAG]      itemChild[" + ic + "] '" + icNm + "' " + icT + " GO(" + goInfo(icT) + ") " + rtInfo(icT));
                                    }
                                }
                            }
                        }
                    } catch (eDiag) {
                        log("[-] Error in diagCarousel: " + eDiag.message);
                    }
                };

                var diagMaterialView = function(sceneThis) {
                    try {
                        var dGo = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                        var dTr = new NativeFunction(baseAddr.add(0x1DB6A94), "pointer", ["pointer", "pointer"]);
                        var dActSelf = new NativeFunction(baseAddr.add(0x1DBAE44), "bool", ["pointer", "pointer"]);
                        var dEnabled = new NativeFunction(baseAddr.add(0x1DB3CBC), "bool", ["pointer", "pointer"]);
                        var dRect = new NativeFunction(baseAddr.add(0x180D6E0), ["float", "float", "float", "float"], ["pointer", "pointer"]);
                        var dPos = new NativeFunction(baseAddr.add(0x180DE48), ["float", "float", "float"], ["pointer", "pointer"]);
                        var dSize = new NativeFunction(baseAddr.add(0x180DB70), ["float", "float"], ["pointer", "pointer"]);
                        var dScale = new NativeFunction(baseAddr.add(0x181DF78), ["float", "float", "float"], ["pointer", "pointer"]);
                        var dChildCount = new NativeFunction(baseAddr.add(0x181ECF0), "int", ["pointer", "pointer"]);
                        var dGetChild = new NativeFunction(baseAddr.add(0x181F128), "pointer", ["pointer", "int", "pointer"]);
                        var dName = new NativeFunction(baseAddr.add(0x1DC5A54), "pointer", ["pointer", "pointer"]);
                        var f2 = function(a) { return a.map(function(v) { return v.toFixed(1); }).join(","); };

                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (sceneView.isNull()) return;
                        var intensifyView = sceneView.add(0x68).readPointer();
                        log("[🧪 DIAG MAT] intensifyView=" + intensifyView);
                        if (intensifyView.isNull()) return;

                        var ivGo = dGo(intensifyView, NULL);
                        var ivTr = dTr(intensifyView, NULL);
                        log("[🧪 DIAG MAT] intensifyView: GOact=" + (!ivGo.isNull() ? dActSelf(ivGo, NULL) : false) + " RT pos=[" + f2(dPos(ivTr, NULL)) + "] size=[" + f2(dSize(ivTr, NULL)) + "]");

                        var matList = intensifyView.add(0x40).readPointer();
                        log("[🧪 DIAG MAT] materialList=" + matList);
                        if (matList.isNull()) return;

                        var count = matList.add(0x18).readS32();
                        var items = matList.add(0x10).readPointer();
                        log("[🧪 DIAG MAT] Material slot count=" + count);

                        var dumpTree = function(trNode, depth) {
                            if (trNode.isNull()) return;
                            var indent = "  ";
                            for (var d = 0; d < depth; d++) indent += "  ";
                            var numChildren = dChildCount(trNode, NULL);
                            for (var k = 0; k < numChildren; k++) {
                                var chTr = dGetChild(trNode, k, NULL);
                                var chNm = readIl2CppString(dName(chTr, NULL));
