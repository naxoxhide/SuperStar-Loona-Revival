                            if (targetScene && !targetScene.isNull()) {
                                try {
                                    log("[📖 SCENE CMD] Switching CardBook tab to MAIN (0)...");
                                    var sceneView = targetScene.add(0x48).readPointer();
                                    if (!sceneView.isNull()) {
                                        var setTabFn = new NativeFunction(baseAddr.add(0x11CF5BC), "bool", ["pointer", "int", "pointer"]);
                                        setTabFn(sceneView, 0, NULL);
                                    }
                                    populateCardBookMainViewOffline(targetScene);
                                } catch (eTm) {
                                    log("[-] Error switching CardBook to main tab: " + eTm.message);
                                }
                            }
                        } else if (cmdRaw === "cb:group" || cmdRaw === "tab:group") {
                            var targetScene = (activeCardBookSceneInstance && !activeCardBookSceneInstance.isNull()) ? activeCardBookSceneInstance : curScene;
                            if (targetScene && !targetScene.isNull()) {
                                try {
                                    log("[📖 SCENE CMD] Switching CardBook tab to GROUP_VIEW (1)...");
                                    var sceneView = targetScene.add(0x48).readPointer();
                                    if (!sceneView.isNull()) {
                                        var setTabFn = new NativeFunction(baseAddr.add(0x11CF5BC), "bool", ["pointer", "int", "pointer"]);
                                        setTabFn(sceneView, 1, NULL);
                                    }
                                    populateCardBookGroupViewOffline(targetScene, 0);
                                } catch (eTg) {
                                    log("[-] Error switching CardBook to group tab: " + eTg.message);
                                }
                            }
                        } else if (cmdRaw.indexOf("cb:page:") === 0) {
                            var cbPage = parseInt(cmdRaw.substring(8).trim(), 10);
                            var targetScene = (activeCardBookSceneInstance && !activeCardBookSceneInstance.isNull()) ? activeCardBookSceneInstance : curScene;
                            if (targetScene && !targetScene.isNull()) {
                                try {
                                    log("[📖 SCENE CMD] Switching CardBook Group page to " + cbPage + "...");
                                    populateCardBookGroupViewOffline(targetScene, cbPage);
                                } catch (eCbp) {
                                    log("[-] Error switching CardBook page: " + eCbp.message);
                                }
                            }
                        } else if (cmdRaw.indexOf("cb:select:") === 0) {
                            var gCodeSel = parseInt(cmdRaw.substring(10).trim(), 10);
                            var targetScene = (activeCardBookSceneInstance && !activeCardBookSceneInstance.isNull()) ? activeCardBookSceneInstance : curScene;
                            if (targetScene && !targetScene.isNull()) {
                                try {
                                    log("[📖 SCENE CMD] Opening CardBookDetailPopup for group: " + gCodeSel + "...");
                                    var targetGroupItem = allCbGroupItemMap[gCodeSel] || cachedLoonaCbGroupItem || NULL;
                                    if (targetGroupItem && !targetGroupItem.isNull()) {
                                        var openDetailFn = new NativeFunction(baseAddr.add(0x11CF9C0), "void", ["pointer", "pointer", "bool", "pointer"]);
                                        openDetailFn(targetScene, targetGroupItem, 1, NULL);
                                    } else {
                                        log("[-] GroupItem not found for code: " + gCodeSel);
                                    }
                                } catch (eCbs) {
                                    log("[-] Error opening CardBook detail popup: " + eCbs.message);
                                }
                            }
                        } else if (cmdRaw.indexOf("eval:") === 0) {
                            var jsCode = cmdRaw.substring(5).trim();
                            try {
                                var evalRes = (function () {
                                    var targetScene = (activeCardBookSceneInstance && !activeCardBookSceneInstance.isNull()) ? activeCardBookSceneInstance : curScene;
                                    return eval(jsCode);
                                })();
                                log("[💡 EVAL RESULT] " + evalRes);
                            } catch (eEv) {
                                log("[-] Error in eval: " + eEv.message);
                            }
                        } else if (cmdRaw === "group" || cmdRaw === "default") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                try {
                                    log("[🚀 SCENE CMD] Switching to group overview (SetStateDefault)...");
                                    var setStateDefaultFn = new NativeFunction(baseAddr.add(0x1053B88), "void", ["pointer", "bool", "bool"]);
                                    setStateDefaultFn(curScene, 0, 0);
                                } catch (eDef) {
                                    log("[-] Error in default cmd: " + eDef.message);
                                }
                            }
                        } else if (cmdRaw.indexOf("group:") === 0) {
                            var gPage = parseInt(cmdRaw.substring(6).trim(), 10);
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                try {
                                    log("[🚀 SCENE CMD] Switching group page to " + gPage + "...");
                                    var onUpdateGroupCountFn = new NativeFunction(baseAddr.add(0x1055090), "void", ["pointer", "int"]);
                                    onUpdateGroupCountFn(curScene, gPage);
                                } catch (eUg) {
                                    log("[-] Error in group:page cmd: " + eUg.message);
                                }
                            }
                        } else if (cmdRaw.indexOf("card:") === 0) {
                            var cardArg = cmdRaw.substring(5).trim();
                            log("[🃏 CARD CMD] Triggering card select for arg: '" + cardArg + "' on scene: " + curScene);
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                if (!loonaCardItems || loonaCardItems.length === 0) {
                                    log("[🃏 CARD CMD] loonaCardItems empty, populating cards on demand...");
                                    try { populateOfflineInventoryCards(); } catch (ePop) {}
                                    try { ensureInventoryLists(curScene); } catch (eEil) {}
                                }
                                var targetCardItem = NULL;
                                try {
                                    var cardIdx = parseInt(cardArg, 10);
                                    var argLower = cardArg.toLowerCase();

                                    // 1. Search directly in global loonaCardItems (covers JinSoul R55 and all equipped LOONA members)
                                    if (loonaCardItems && loonaCardItems.length > 0) {
                                        for (var lk = 0; lk < loonaCardItems.length; lk++) {
                                            var itm = loonaCardItems[lk];
                                            if (!itm || itm.isNull()) continue;
                                            var r = itm.add(0x10).readPointer();
                                            if (!r || r.isNull()) continue;
                                            var cid = r.add(0x20).readS32();
                                            var isEqC = (r.add(0x28).readU8() === 1);
                                            var m = getCardMetadata(cid);
                                            var aName = (m && m.artistID && artistNamesMap[m.artistID]) ? artistNamesMap[m.artistID].toLowerCase() : "";
                                            if (argLower === "unequipped") {
                                                if (!isEqC) {
                                                    targetCardItem = itm;
                                                    log("[🃏 CARD CMD] Found unequipped card in loonaCardItems at index " + lk + " (cardID=" + cid + ", artist=" + aName + ")");
                                                    break;
                                                }
                                                continue;
                                            }
                                            if (argLower === "a" || argLower === "rank:a" || argLower === "grade:2") {
                                                if (!r.isNull() && r.add(0x24).readS32() === 2) {
                                                    targetCardItem = itm;
                                                    log("[🃏 CARD CMD] Found Grade 2 (A-Rank) card in loonaCardItems at index " + lk + " (cardID=" + cid + ")");
                                                    break;
                                                }
                                                continue;
                                            }
                                            if (argLower === "s" || argLower === "rank:s" || argLower === "grade:3") {
                                                if (!r.isNull() && r.add(0x24).readS32() === 3) {
                                                    targetCardItem = itm;
                                                    log("[🃏 CARD CMD] Found Grade 3 (S-Rank) card in loonaCardItems at index " + lk + " (cardID=" + cid + ")");
                                                    break;
                                                }
                                                continue;
                                            }
                                            if (argLower === "c" || argLower === "rank:c" || argLower === "grade:0") {
                                                if (!r.isNull() && r.add(0x24).readS32() === 0) {
                                                    targetCardItem = itm;
                                                    log("[🃏 CARD CMD] Found Grade 0 (C-Rank) card in loonaCardItems at index " + lk + " (cardID=" + cid + ")");
                                                    break;
                                                }
                                                continue;
                                            }
                                            if ((argLower === "jinsoul" || cardArg === "1007" || argLower === "r55" || argLower === "r50") && (cid === 1007 || aName === "jinsoul")) {
                                                targetCardItem = itm;
                                                log("[🃏 CARD CMD] Found JinSoul card in loonaCardItems at index " + lk + " (cardID=" + cid + ")");
                                                break;
                                            }
                                            if (aName === argLower || cid.toString() === cardArg) {
                                                targetCardItem = itm;
                                                log("[🃏 CARD CMD] Found card in loonaCardItems at index " + lk + " (cardID=" + cid + ", artist=" + aName + ")");
                                                break;
                                            }
                                        }
                                    }

                                    // 2. Fallback to displayCardList
                                    if (!targetCardItem || targetCardItem.isNull()) {
                                        var dclPtr = curScene.add(0x58).readPointer();
                                        if (!dclPtr.isNull()) {
                                            var listItems = dclPtr.add(0x10).readPointer();
                                            var listSize = dclPtr.add(0x18).readS32();
                                            if (isNaN(cardIdx) || cardIdx < 0 || cardIdx >= listSize) cardIdx = 0;
                                            if (!listItems.isNull() && listSize > 0) {
                                                targetCardItem = listItems.add(0x20 + cardIdx * 8).readPointer();
                                                log("[🃏 CARD CMD] Selected CardItem[" + cardIdx + "] = " + targetCardItem + " (out of " + listSize + ")");
                                            }
                                        }
                                    }
                                } catch (eDclCmd) {
                                    log("[-] Error resolving card in CARD CMD: " + eDclCmd.message);
                                }
                                if ((!targetCardItem || targetCardItem.isNull()) && loonaCardItems && loonaCardItems.length > 0) {
                                    targetCardItem = loonaCardItems[0];
                                }
                                if (targetCardItem && !targetCardItem.isNull()) {
                                    var rawCard = targetCardItem.add(0x10).readPointer();
                                    var cId = rawCard.add(0x20).readS32();
                                    var meta = getCardMetadata(cId);
                                    var memberIdx = (meta.artistID >= 1000) ? (meta.artistID - 1000) : meta.artistID;
                                    if (memberIdx < 1 || memberIdx > 11) memberIdx = ((cId - 1001) % 11) + 1;
                                    var artistData = loonaArtistDataMap[memberIdx] || NULL;

                                    curScene.add(0x88).writePointer(targetCardItem);
                                    curScene.add(0x98).writePointer(targetCardItem);
                                    curScene.add(0x80).writePointer(artistData);
                                    safeSetStateMain(curScene, 0);
                                    log("[🎉 CARD CMD SUCCESS] safeSetStateMain(0) invoked on InventoryScene for cardID=" + cId + ", theme=" + meta.theme);
                                }
                            } else {
                                log("[-] CARD CMD failed: curScene is null or sceneId != 4 (sceneId=" + sceneId + ", instance=" + curScene + ")");
                            }
                        } else if (cmdRaw === "diag") {
                            if (curScene && !curScene.isNull() && sceneId === 4) diagCarousel(curScene);
                        } else if (cmdRaw === "diag_mat") {
                            if (curScene && !curScene.isNull() && sceneId === 4) diagMaterialView(curScene);
                        } else if (cmdRaw === "lock") {
                            if (curScene && !curScene.isNull() && sceneId === 4) executeOfflineLock(curScene, null);
                        } else if (cmdRaw === "leader") {
                            if (curScene && !curScene.isNull() && sceneId === 4) executeOfflineLeader(curScene);
                        } else if (cmdRaw === "sell") {
                            if (curScene && !curScene.isNull() && sceneId === 4) executeOfflineSell(curScene);
                        } else if (cmdRaw === "sell_all") {
                            if (curScene && !curScene.isNull() && sceneId === 4) executeOfflineSellBundle(curScene, 1);
                        } else if (cmdRaw.indexOf("unmat:") === 0) {
                            var slotArg = parseInt(cmdRaw.substring(6).trim(), 10) || 0;
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                handleUnregisterPedestalSlot(curScene, slotArg);
                            }
                        } else if (cmdRaw.indexOf("tap_cell:") === 0) {
                            var cellArg = parseInt(cmdRaw.substring(9).trim(), 10) || 0;
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[📱 TAP_CELL CMD] Simulating carousel tap on cell index: " + cellArg);
                                try {
                                    var dcl = curScene.add(0x58).readPointer();
                                    if (!dcl.isNull()) {
                                        var dclCount = dcl.add(0x18).readS32();
                                        var dclItems = dcl.add(0x10).readPointer();
                                        if (cellArg >= 0 && cellArg < dclCount && !dclItems.isNull()) {
                                            var clickedCard = dclItems.add(0x20 + cellArg * 8).readPointer();
                                            if (!clickedCard.isNull()) {
                                                var curState = curScene.add(0x24).readS32();
                                                if (curState === 8) {
                                                    var matList = curScene.add(0xA0).readPointer();
                                                    var curCount = (!matList.isNull()) ? matList.add(0x18).readS32() : 0;
                                                    if (curCount < 5) {
                                                        var clickedRaw = clickedCard.add(0x10).readPointer();
                                                        if (!clickedRaw.isNull()) {
                                                            var cId = clickedRaw.add(0x20).readS32();
                                                            var ccd = getOrCreateCardControlData(cId);
                                                            clickedCard.add(0x18).writePointer(ccd || NULL);
                                                            var gr = clickedRaw.add(0x24).readS32();
                                                            var lvl = clickedRaw.add(0x1C).readS16();
                                                            var fCode = (gr < 4) ? (gr * 5 + Math.min(4, lvl - 1)) : (20 + Math.min(98, lvl - 1));
                                                            clickedCard.add(0x20).writeS16(fCode);
                                                        }
                                                        var regFn = new NativeFunction(baseAddr.add(0x1056B5C), "void", ["pointer", "pointer"]);
                                                        regFn(curScene, clickedCard);
                                                        try {
                                                            var playSeFn = new NativeFunction(baseAddr.add(0xD0A3B4), "void", ["pointer", "pointer"]);
                                                            playSeFn(createIl2CppString("cardselect"), NULL);
                                                        } catch (eSeC) {}
                                                        safeRefreshIntensifyView(curScene);
                                                        populateMaterialDisplayCardList(curScene);
                                                        log("[📱 TAP_CELL SUCCESS] Registered cell[" + cellArg + "] into pedestal!");
                                                    } else {
                                                        log("[⚠️ TAP_CELL] Pedestal slots full (5/5)!");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } catch (eTapCell) {
                                    log("[-] Error in tap_cell: " + eTapCell.message);
                                }
                            }
                        } else if (cmdRaw === "change") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[🗃️ CHANGE CMD] Triggering OnChange directly!");
                                var onChangeFn = new NativeFunction(baseAddr.add(0x105A61C), "void", ["pointer", "pointer"]);
                                onChangeFn(curScene, NULL);
                            }
                        } else if (cmdRaw === "intensify") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[⚡ INTENSIFY CMD] Dispatching triggerSafeOnIntensify cleanly!");
                                triggerSafeOnIntensify(curScene);
                            }
                        } else if (cmdRaw === "recommend" || cmdRaw === "rec" || cmdRaw.indexOf("recommend_") === 0 || cmdRaw.indexOf("rec_") === 0) {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                var recCount = 5;
                                if (cmdRaw.indexOf("recommend_") === 0) recCount = parseInt(cmdRaw.split("_")[1], 10) || 5;
                                else if (cmdRaw.indexOf("rec_") === 0) recCount = parseInt(cmdRaw.split("_")[1], 10) || 5;
                                log("[⚡ RECOMMEND CMD] Triggering executeRecommend with " + recCount + " cards!");
                                executeRecommend(curScene, recCount);
                            }
                        } else if (cmdRaw === "try") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[⚡ TRY CMD] Executing native intensify try with animated popup modal!");
                                triggerNativeIntensifyTry(curScene);
                            }
                        } else if (cmdRaw === "try_direct") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[⚡ TRY DIRECT CMD] Executing direct intensify try with animated popup modal!");
                                triggerDirectPopup(curScene);
                            }
                        } else if (cmdRaw === "try_native") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[⚡ TRY NATIVE CMD] Executing native InventoryScene.OnIntensifyTry!");
                                triggerNativeIntensifyTry(curScene);
                            }
                        } else if (cmdRaw === "show_view") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                var sv = curScene.add(0x48).readPointer();
                                if (!sv.isNull()) {
                                    var showFn = new NativeFunction(baseAddr.add(0x10607AC), "void", ["pointer", "pointer"]);
                                    showFn(sv, NULL);
                                    log("[👁️ SHOW VIEW CMD] InventoryView.Show (0x10607AC) called!");
                                }
                            }
                        } else if (cmdRaw === "try_popup" || cmdRaw === "try_result") {
                            if (activeCardIntensifyPopup && !activeCardIntensifyPopup.isNull()) {
                                log("[⚡ TRY POPUP CMD] Triggering triggerPopupIntensifyResult on: " + activeCardIntensifyPopup);
                                triggerPopupIntensifyResult(activeCardIntensifyPopup);
                            } else {
                                log("[-] TRY POPUP CMD: activeCardIntensifyPopup is null!");
                            }
                        } else if (cmdRaw === "next" || cmdRaw === "click_next") {
                            if (activeCardIntensifyPopup && !activeCardIntensifyPopup.isNull()) {
                                log("[👉 CLICK NEXT] Invoking OnClickOverride directly for: " + activeCardIntensifyPopup);
                                try {
                                    var onClickOverrideFn = new NativeFunction(baseAddr.add(0x138407C), "bool", ["pointer", "pointer"]);
                                    var ret = onClickOverrideFn(activeCardIntensifyPopup, NULL);
                                    if (ret !== 0) {
                                        var closeFn = new NativeFunction(baseAddr.add(0x114247C), "void", ["pointer"]);
                                        closeFn(activeCardIntensifyPopup);
                                    }
                                } catch (eNext) {
                                    log("[-] Error in click_next: " + eNext.message);
                                }
                            } else {
                                log("[-] CLICK NEXT: activeCardIntensifyPopup is null!");
                            }
                        } else if (cmdRaw === "ok" || cmdRaw === "click_ok" || cmdRaw === "close_popup" || cmdRaw === "dismiss_popup") {
                            if (activeCardIntensifyPopup && !activeCardIntensifyPopup.isNull()) {
                                log("[👉 CLICK OK] Invoking OnClickOverride & Popup.Close for: " + activeCardIntensifyPopup);
                                try {
                                    var onClickOverrideFn = new NativeFunction(baseAddr.add(0x138407C), "bool", ["pointer", "pointer"]);
                                    onClickOverrideFn(activeCardIntensifyPopup, NULL);
                                } catch (eOkOv) {}
                                try {
                                    var closeFn = new NativeFunction(baseAddr.add(0x114247C), "void", ["pointer"]);
                                    closeFn(activeCardIntensifyPopup);
                                } catch (eClsPop) {}
                            } else {
                                log("[-] CLOSE/OK POPUP CMD: activeCardIntensifyPopup is null!");
                            }
                        } else if (cmdRaw.indexOf("cmd:fail") !== -1) {
                            testIntensifyMode = "force_fail";
                            log("[🧪 TEST MODE] Set testIntensifyMode = 'force_fail' (All materials will FAIL)");
                        } else if (cmdRaw.indexOf("cmd:success") !== -1) {
                            testIntensifyMode = "force_success";
                            log("[🧪 TEST MODE] Set testIntensifyMode = 'force_success' (All materials will SUCCEED)");
                        } else if (cmdRaw.indexOf("cmd:step") !== -1) {
                            testIntensifyMode = "step_demo";
                            log("[🧪 TEST MODE] Set testIntensifyMode = 'step_demo' (Material 1 Fails -> Next -> Material 2 Succeeds -> OK)");
                        } else if (cmdRaw.indexOf("cmd:normal") !== -1) {
                            testIntensifyMode = "normal";
                            log("[🧪 TEST MODE] Set testIntensifyMode = 'normal'");
                        } else if (cmdRaw === "mat_diag") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                var target = curScene.add(0x88).readPointer();
                                var matListPtr = curScene.add(0xA0).readPointer();
                                var dcl = curScene.add(0x58).readPointer();
                                var sv = curScene.add(0x48).readPointer();
                                var bbs = (!sv.isNull()) ? sv.add(0xC0).readPointer() : NULL;
                                var matCount = (!matListPtr.isNull()) ? matListPtr.add(0x18).readS32() : 0;
                                var dclCount = (!dcl.isNull()) ? dcl.add(0x18).readS32() : 0;
                                var tCard = (!target.isNull()) ? target.add(0x18).readPointer() : NULL;
                                var tCode = (!target.isNull()) ? target.add(0x20).readS16() : -1;
                                log("[🔍 MAT_DIAG] target=" + target + " (Card=" + tCard + ", Code=" + tCode + "), matListCount=" + matCount + ", sv=" + sv + ", bbs=" + bbs + ", extractType=" + curScene.add(0x50).readS32());
                                try {
                                    var x22Ptr = baseAddr.add(0x30E40F0).readPointer();
                                    var kPtr = (!x22Ptr.isNull()) ? x22Ptr.readPointer() : NULL;
                                    var sfPtr = (!kPtr.isNull()) ? kPtr.add(0xB8).readPointer() : NULL;
                                    var instPtr = (!sfPtr.isNull()) ? sfPtr.readPointer() : NULL;
                                    log("[🔍 INTENSIFY_ASSIST_DIAG] x22=" + x22Ptr + " k=" + kPtr + " sf=" + sfPtr + " inst=" + instPtr);
                                } catch (eIad) {
                                    log("[-] Error reading intensify assist diag: " + eIad.message);
                                }
                            }
                        } else if (cmdRaw === "diag_ui") {
                            if (curScene && !curScene.isNull() && sceneId === 4) {
                                log("[🔍 DIAG_UI] Starting InventoryView hierarchy scan...");
                                var sceneView = curScene.add(0x48).readPointer();
                                if (!sceneView.isNull()) {
                                    var dGo = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                                    var dTr = new NativeFunction(baseAddr.add(0x1DB6A94), "pointer", ["pointer", "pointer"]);
                                    var dActSelf = new NativeFunction(baseAddr.add(0x1DBAE44), "bool", ["pointer", "pointer"]);
                                    var dActHier = new NativeFunction(baseAddr.add(0x1DBAE84), "bool", ["pointer", "pointer"]);
                                    var dChildCount = new NativeFunction(baseAddr.add(0x181ECF0), "int", ["pointer", "pointer"]);
                                    var dGetChild = new NativeFunction(baseAddr.add(0x181F128), "pointer", ["pointer", "int", "pointer"]);
                                    var dName = new NativeFunction(baseAddr.add(0x1DC5A54), "pointer", ["pointer", "pointer"]);
                                    var dPos = new NativeFunction(baseAddr.add(0x180DE48), ["float", "float", "float"], ["pointer", "pointer"]);
                                    var dSize = new NativeFunction(baseAddr.add(0x180DB70), ["float", "float"], ["pointer", "pointer"]);

                                    var readName = function(obj) {
                                        try {
                                            var sPtr = dName(obj, NULL);
                                            return readIl2CppString(sPtr) || "unknown";
                                        } catch (eN) { return "err"; }
                                    };

                                    // btnBack check
                                    var btnBack = sceneView.add(0x88).readPointer();
                                    if (!btnBack.isNull()) {
                                        var bbGo = btnBack.add(0x10).readPointer();
                                        var bbTr = btnBack.add(0x18).readPointer();
                                        var bbBox = btnBack.add(0x50).readPointer();
                                        var bbPos = dPos(bbTr, NULL);
                                        var bbSize = dSize(bbTr, NULL);
                                        log("[🔍 DIAG_UI] btnBack: go=" + bbGo + " name=" + readName(bbGo) + " actSelf=" + dActSelf(bbGo, NULL) + " actHier=" + dActHier(bbGo, NULL) + " pos=[" + bbPos.map(function(v){return v.toFixed(0);}).join(",") + "] size=[" + bbSize.map(function(v){return v.toFixed(0);}).join(",") + "] box=" + bbBox);
                                    }

                                    // Scan direct children of sceneView
                                    var svTr = dTr(sceneView, NULL);
                                    var cCount = dChildCount(svTr, NULL);
                                    log("[🔍 DIAG_UI] sceneView transform=" + svTr + " childCount=" + cCount);
                                    for (var ci = 0; ci < cCount; ci++) {
                                        var ch = dGetChild(svTr, ci, NULL);
                                        if (ch.isNull()) continue;
                                        var cGo = dGo(ch, NULL);
                                        var cName = readName(cGo);
                                        var cH = dActHier(cGo, NULL);
                                        var cS = dActSelf(cGo, NULL);
                                        var cP = dPos(ch, NULL);
                                        var cSz = dSize(ch, NULL);
                                        log("[🔍 DIAG_UI] [" + ci + "] " + cName + " hier=" + cH + " self=" + cS + " pos=[" + cP.map(function(v){return v.toFixed(0);}).join(",") + "] size=[" + cSz.map(function(v){return v.toFixed(0);}).join(",") + "]");
                                        // Scan 1 sub-level
                                        var subCount = dChildCount(ch, NULL);
                                        for (var si = 0; si < subCount; si++) {
                                            var sch = dGetChild(ch, si, NULL);
                                            if (sch.isNull()) continue;
                                            var sGo = dGo(sch, NULL);
                                            var sH = dActHier(sGo, NULL);
