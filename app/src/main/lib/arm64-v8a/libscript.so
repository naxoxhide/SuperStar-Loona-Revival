                                    var cMeta = getCardMetadata(c.cardID);
                                    var cGroup = (cMeta && (cMeta.groupID || cMeta.group)) ? (cMeta.groupID || cMeta.group) : (c.groupID || 1001);
                                    var cArtist = (cMeta && cMeta.artistID) ? cMeta.artistID : (c.artistID || c.cardID);
