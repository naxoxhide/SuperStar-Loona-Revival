                                // 1. Deactivate majorFrame and majorEmblem (Dalcom envelopes) for LOONA
                                var mf = this.cellView.add(0x60).readPointer();
                                if (!mf.isNull()) setActFn(mf, 0, NULL);
                                var me = this.cellView.add(0x68).readPointer();
