                                            var spGradeR = getSpFn(gradeSpComp, 4, NULL);
                                            var spGraphR = getSpFn(gaugeSpComp, 4, NULL);
                                            if (!spGradeR.isNull()) setSpFn(grade, spGradeR, NULL);
                                            if (!spGraphR.isNull()) setSpFn(gauge, spGraphR, NULL);
