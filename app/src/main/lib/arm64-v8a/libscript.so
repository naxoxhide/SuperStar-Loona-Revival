                var handleAllUnequipOffline = function() {
                    try {
                        var gCode = currentSelectedGroupCode || 1001;
                        log("[🗃️ ALL_UNEQUIP] Unequipping all cards for group=" + gCode + "...");
                        var profile = loadPlayerProfile();
