                var lobbyBgDataMap = {};        // code -> LobbyBgDataControl.Data
                var lobbyBgMetaMap = {};        // code -> raw lbg row
                var lobbyBgFreeSet = {};        // code -> true (1001..1011 base free wallpapers from lbs.json sellType===3)
