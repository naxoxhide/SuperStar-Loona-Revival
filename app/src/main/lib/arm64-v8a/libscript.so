                            isMaxLevel: false,
                            level: 0,
                            maxLevel: Math.max(1, themeCount),
                            gauge: 0.0,
                            currentPoint: 0,
                            nextPoint: Math.max(1, totalSlots),
                            themePoints: 0,
                            maxThemePoints: maxThemePoints,
                            points: 0,
                            totalSlots: totalSlots,
                            obtainedCards: 0,
                            rCardCount: 0
                        };
                    }

                    // CASE 1: Group has R cards
                    if (rCardCount > 0) {
                        var isMaxLevel = (rCardCount === totalSlots && totalSlots > 0);
                        var level = 0;
                        var nextLevelThreshold = totalSlots;
                        if (themeCount > 0) {
                            for (var th = 1; th <= themeCount; th++) {
                                var threshold = Math.round((totalSlots / themeCount) * th);
                                if (threshold <= rCardCount) {
                                    level = th;
                                } else {
                                    nextLevelThreshold = threshold;
                                    break;
                                }
                            }
                        }
                        if (isMaxLevel) {
                            level = themeCount;
                            nextLevelThreshold = totalSlots;
                        }
                        var gauge = nextLevelThreshold > 0 ? Math.min(1.0, rCardCount / nextLevelThreshold) : 1.0;
                        return {
                            grade: 4, // R
                            nextGrade: 4,
                            isRGrade: true,
                            isMaxLevel: isMaxLevel,
                            level: level,
                            maxLevel: Math.max(1, themeCount),
                            gauge: gauge,
                            currentPoint: rCardCount,
                            nextPoint: nextLevelThreshold,
                            themePoints: themePoints,
                            maxThemePoints: maxThemePoints,
                            points: themePoints * 100 + rCardCount * 10 + nonRPoints,
                            totalSlots: totalSlots,
                            obtainedCards: obtainedCards,
                            rCardCount: rCardCount
                        };
                    }

                    // CASE 2: Group has non-R cards (C=1, B=2, A=3, S=4 per slot; avg = nonRPoints / totalSlots)
                    var avg = nonRPoints / totalSlots;
                    var grade = 0;
                    var nextPoint = totalSlots;
                    var gauge = 0.0;
                    if (avg >= 3.0) {
                        grade = 3; // S -> next is R (all cards upgraded)
                        nextPoint = 4 * totalSlots;
                        gauge = Math.min(1.0, nonRPoints / nextPoint);
                    } else if (avg >= 2.0) {
                        grade = 2; // A
                        nextPoint = 3 * totalSlots;
                        gauge = Math.min(1.0, (avg - 2.0) / 1.0);
                    } else if (avg >= 1.0) {
                        grade = 1; // B
                        nextPoint = 2 * totalSlots;
                        gauge = Math.min(1.0, (avg - 1.0) / 1.0);
                    } else {
                        grade = 0; // C
                        nextPoint = totalSlots;
                        gauge = Math.min(1.0, avg / 1.0);
                    }

                    return {
                        grade: grade,
                        nextGrade: Math.min(4, grade + 1),
                        isRGrade: false,
                        isMaxLevel: false,
                        level: 0,
                        maxLevel: Math.max(1, themeCount),
                        gauge: gauge,
                        currentPoint: nonRPoints,
                        nextPoint: Math.max(1, nextPoint),
                        themePoints: themePoints,
                        maxThemePoints: maxThemePoints,
                        points: themePoints * 100 + nonRPoints,
                        totalSlots: totalSlots,
                        obtainedCards: obtainedCards,
                        rCardCount: 0
                    };
                };

                var populateBestCardBookBanner = function (sceneThis) {
                    try {
                        if (!sceneThis || sceneThis.isNull()) return;
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (sceneView.isNull()) return;

                        var statusParamKlass = resolveMetadataSlot(0x31F0FD0);
                        if (!statusParamKlass || statusParamKlass.isNull()) return;

                        // Dynamically find best group among playable groups
                        var metaAll = getGlobalMetadata();
                        var playables = (metaAll && metaAll.playableGroups) ? metaAll.playableGroups : PLAYABLE_GROUP_CODES;
                        var bestGCode = 1001;
                        var bestMetrics = null;
                        var bestScore = -1;

                        for (var b = 0; b < playables.length; b++) {
                            var checkGc = playables[b];
                            var m = calculateOfflineGroupCardBookMetrics(checkGc);
                            var compositeScore = m.grade * 1000000 + m.points;
                            if (compositeScore > bestScore) {
                                bestScore = compositeScore;
                                bestGCode = checkGc;
                                bestMetrics = m;
                            }
                        }
                        if (!bestMetrics) bestMetrics = calculateOfflineGroupCardBookMetrics(bestGCode);

                        var spObj = il2cpp_object_new(statusParamKlass);
                        if (il2cpp_gchandle_new && !spObj.isNull()) il2cpp_gchandle_new(spObj, 2);
                        spObj.add(0x10).writeS32(bestMetrics.grade);
                        spObj.add(0x14).writeU8(bestMetrics.isRGrade ? 1 : 0);
                        spObj.add(0x15).writeU8(bestMetrics.isMaxLevel ? 1 : 0);
                        spObj.add(0x18).writeS32(bestMetrics.level);
                        spObj.add(0x1C).writeU8(0);      // useEffect = false
                        spObj.add(0x20).writeFloat(bestMetrics.gauge);

                        var baseBestGc = getBaseGroupCode(bestGCode);
                        var bestGMeta = (metaAll && metaAll.groups) ? metaAll.groups[bestGCode] : null;
                        var bestGName = (bestGMeta && bestGMeta.name) ? bestGMeta.name : ("[+ +]");
                        var bestEmbPath = "asiudgasg/asodhsg/aweoijs/" + baseBestGc + ".i.bytes";
                        var bestImgPath = "asiudgasg/asodhsg/foewghkc/" + baseBestGc + ".i.bytes";

                        var headerStr = createIl2CppString("BEST CARD BOOK");
                        var groupNameStr = createIl2CppString(bestGName);
                        var emblemDp = createDownloadPath(bestEmbPath);
                        var imageDp = createDownloadPath(bestImgPath);

                        var setBestFn = new NativeFunction(baseAddr.add(0x11D0A24), "void", ["pointer", "pointer", "pointer", "pointer", "pointer", "pointer", "pointer"]);
                        setBestFn(sceneView, headerStr, groupNameStr, emblemDp, imageDp, spObj, NULL);

                        var getGoFn = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                        var setActFn = new NativeFunction(baseAddr.add(0x1DBADF4), "void", ["pointer", "bool", "pointer"]);
                        var getTfFn = new NativeFunction(baseAddr.add(0x1DB6A94), "pointer", ["pointer", "pointer"]);
                        var getChildFn = new NativeFunction(baseAddr.add(0x181F128), "pointer", ["pointer", "int", "pointer"]);

                        // Direct guarantee of bestImage texture and proper RectTransform stretch positioning
                        try {
                            var bestImg = sceneView.add(0xA8).readPointer();
                            if (!bestImg.isNull()) {
                                var bgTex = loadLocalTexture2D(bestImgPath);
                                if (bgTex && !bgTex.isNull()) {
                                    var setTexFn = new NativeFunction(baseAddr.add(0x194C074), "void", ["pointer", "pointer", "pointer"]);
                                    setTexFn(bestImg, bgTex, NULL);

                                    // Set full opacity white
                                    bestImg.add(0x20).writeFloat(1.0);
                                    bestImg.add(0x24).writeFloat(1.0);
                                    bestImg.add(0x28).writeFloat(1.0);
                                    bestImg.add(0x2C).writeFloat(1.0);

                                    // Ensure Behaviour component is enabled (0x1DB3CFC)
                                    try {
                                        var setEnabledFn = new NativeFunction(baseAddr.add(0x1DB3CFC), "void", ["pointer", "int"]);
                                        setEnabledFn(bestImg, 1);
                                    } catch (eEn) {}

                                    var biGo = getGoFn(bestImg, NULL);
                                    if (!biGo.isNull()) setActFn(biGo, 1, NULL);

                                    // Configure RectTransform to stretch cleanly across TitleArea (0,0) to (1,1)
                                    try {
                                        var getRtFn = new NativeFunction(baseAddr.add(0x1DB6A94), "pointer", ["pointer", "pointer"]);
                                        var myBgRt = getRtFn(bestImg, NULL);
                                        if (!myBgRt.isNull()) {
                                            var setPosFn = new NativeFunction(baseAddr.add(0x180DB20), "void", ["pointer", "pointer"]);
                                            var setSizeFn = new NativeFunction(baseAddr.add(0x180DC6C), "void", ["pointer", "pointer"]);
                                            var setMinFn = new NativeFunction(baseAddr.add(0x180D888), "void", ["pointer", "pointer"]);
                                            var setMaxFn = new NativeFunction(baseAddr.add(0x180D9D4), "void", ["pointer", "pointer"]);
                                            var setPivFn = new NativeFunction(baseAddr.add(0x180DDB8), "void", ["pointer", "pointer"]);
                                            var setSibFn = new NativeFunction(baseAddr.add(0x181EDB0), "void", ["pointer", "int", "pointer"]);

                                            var vZero = Memory.alloc(8);
                                            vZero.writeFloat(0.0);
                                            vZero.add(4).writeFloat(0.0);

                                            var vOne = Memory.alloc(8);
                                            vOne.writeFloat(1.0);
                                            vOne.add(4).writeFloat(1.0);

                                            var vHalf = Memory.alloc(8);
                                            vHalf.writeFloat(0.5);
                                            vHalf.add(4).writeFloat(0.5);

                                            setMinFn(myBgRt, vZero);
                                            setMaxFn(myBgRt, vOne);
                                            setPivFn(myBgRt, vHalf);
                                            setPosFn(myBgRt, vZero);
                                            setSizeFn(myBgRt, vZero);

                                            setSibFn(myBgRt, 1, NULL); // Place above +bg placeholder
                                        }
                                    } catch (eRt) {
                                        log("[-] Error configuring bestImage RectTransform: " + eRt.message);
                                    }

                                    log("[📖 CARDBOOK] Directly applied bestImage background texture and geometry for group " + bestGCode);
                                }
                            }
                        } catch (eBi) {}

                        // Deactivate bestBase child (+bg) gray placeholder quad to reveal banner
                        try {
                            var bestBase = sceneView.add(0x88).readPointer(); // UICache
                            if (!bestBase.isNull()) {
                                var bbTf = bestBase.add(0x18).readPointer(); // Transform
                                if (!bbTf.isNull()) {
                                    var getChildCountFn = new NativeFunction(baseAddr.add(0x181ECF0), "int", ["pointer"]);
                                    var count = getChildCountFn(bbTf);
                                    var getNameFn = new NativeFunction(baseAddr.add(0x1DC5A54), "pointer", ["pointer"]);
                                    for (var c = 0; c < count; c++) {
                                        var chTf = getChildFn(bbTf, c, NULL);
                                        if (!chTf.isNull()) {
                                            var chGo = getGoFn(chTf, NULL);
                                            if (!chGo.isNull()) {
                                                var nPtr = getNameFn(chGo);
                                                if (!nPtr.isNull()) {
                                                    var nLen = nPtr.add(0x10).readS32();
                                                    var chName = nPtr.add(0x14).readUtf16String(nLen);
                                                    if (chName === "+bg") {
                                                        setActFn(chGo, 0, NULL);
                                                        log("[📖 CARDBOOK] Deactivated +bg placeholder quad!");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } catch (ePb) {
                            log("[-] Error deactivating +bg placeholder: " + ePb.message);
                        }

                        // Direct guarantee of bestEmblem texture
                        try {
                            var bestEmb = sceneView.add(0xA0).readPointer();
                            if (!bestEmb.isNull()) {
                                var embRaw = bestEmb.add(0x40).readPointer();
                                if (!embRaw.isNull()) {
                                    var embTex = loadLocalTexture2D(bestEmbPath);
                                    if (embTex && !embTex.isNull()) {
                                        var setTexFn = new NativeFunction(baseAddr.add(0x194C074), "void", ["pointer", "pointer", "pointer"]);
                                        setTexFn(embRaw, embTex, NULL);
                                        var setNativeSizeFn = new NativeFunction(baseAddr.add(0x194C1C8), "void", ["pointer", "pointer"]);
                                        setNativeSizeFn(embRaw, NULL);
                                        embRaw.add(0x20).writeFloat(1.0);
                                        embRaw.add(0x24).writeFloat(1.0);
                                        embRaw.add(0x28).writeFloat(1.0);
                                        embRaw.add(0x2C).writeFloat(1.0);
                                        var beGo = getGoFn(embRaw, NULL);
                                        if (!beGo.isNull()) setActFn(beGo, 1, NULL);
                                    }
                                }
                            }
                        } catch (eBe) {}

                        log("[📖 CARDBOOK] SetBest cleanly invoked offline for group " + bestGCode + " (Grade " + bestMetrics.grade + ", Level " + bestMetrics.level + ")!");
                    } catch (eSb) {
                        log("[-] Error in SetBest: " + eSb.message);
                    }
                };

                var populateFavoriteGroupsOffline = function (sceneThis) {
                    try {
                        if (!sceneThis || sceneThis.isNull()) return;
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (sceneView.isNull()) return;
                        var mainView = sceneView.add(0xE0).readPointer();
                        if (mainView.isNull()) return;

                        var favItemList = mainView.add(0x58).readPointer(); // CardBookFavoriteGroupItemView[] (len 5)
                        var favEmptyList = mainView.add(0x60).readPointer(); // GameObject[] (len 5)
                        var favBgList = mainView.add(0x48).readPointer(); // GameObject[] (len 5)
                        if (favItemList.isNull()) return;

                        var getGoFn = new NativeFunction(baseAddr.add(0x1DB6AD4), "pointer", ["pointer", "pointer"]);
                        var setActFn = new NativeFunction(baseAddr.add(0x1DBADF4), "void", ["pointer", "bool", "pointer"]);
                        var setFavCellFn = new NativeFunction(baseAddr.add(0x11CD330), "void", ["pointer", "pointer", "pointer"]);

                        var favParamKlass = resolveMetadataSlot(0x31F0F48);
                        var favDisplayNames = {
                            1001: "+ +",
                            2001: "[X X]",
                            3001: "[#]",
                            4001: "[12:00]",
                            5001: "[&]"
                        };

                        var metaAll = getGlobalMetadata();
                        var favCodes = getOfflineFavoriteGroups();
                        offlineFavoriteGroups = favCodes;

                        var arrLen = favItemList.add(0x18).readS32();
                        for (var i = 0; i < arrLen && i < 5; i++) {
                            var favCell = favItemList.add(0x20 + i * 8).readPointer();
                            var emptyGo = (!favEmptyList.isNull() && i < favEmptyList.add(0x18).readS32())
                                ? favEmptyList.add(0x20 + i * 8).readPointer()
                                : NULL;
                            var bgGo = (!favBgList.isNull() && i < favBgList.add(0x18).readS32())
                                ? favBgList.add(0x20 + i * 8).readPointer()
                                : NULL;

                            if (i < favCodes.length && favParamKlass && !favParamKlass.isNull()) {
                                var gCode = favCodes[i];
                                var baseGc = getBaseGroupCode(gCode);
                                var gMeta = (metaAll && metaAll.groups) ? metaAll.groups[gCode] : null;
                                var gName = (favDisplayNames && favDisplayNames[gCode]) ? favDisplayNames[gCode] : ((gMeta && gMeta.name) ? gMeta.name : ("Group " + gCode));
                                var embPath = "asiudgasg/asodhsg/aweoijs/" + baseGc + ".i.bytes";

                                // 1. Activate background GameObject
                                if (!bgGo.isNull()) {
                                    setActFn(bgGo, 1, NULL);
                                }
                                // 2. Hide empty placeholder (---)
                                if (!emptyGo.isNull()) {
                                    setActFn(emptyGo, 0, NULL);
                                }

                                if (!favCell.isNull()) {
                                    var fvGo = getGoFn(favCell, NULL);
                                    if (!fvGo.isNull()) setActFn(fvGo, 1, NULL);

                                    var fParam = il2cpp_object_new(favParamKlass);
                                    if (il2cpp_gchandle_new && !fParam.isNull()) il2cpp_gchandle_new(fParam, 2);
                                    fParam.add(0x10).writePointer(createIl2CppString(gName));
                                    fParam.add(0x18).writePointer(createDownloadPath(embPath));
                                    fParam.add(0x20).writeU8(0); // newmark = false
                                    setFavCellFn(favCell, fParam, NULL);

                                    // Explicitly apply text to artistName
                                    try {
                                        var nameTxt = favCell.add(0x40).readPointer();
                                        if (!nameTxt.isNull()) {
                                            var setTextFn = new NativeFunction(baseAddr.add(0x21A5FC4), "void", ["pointer", "pointer", "pointer"]);
                                            setTextFn(nameTxt, createIl2CppString(gName), NULL);
                                        }
                                    } catch (eTxt) {}

                                    // Explicitly apply emblem texture to RawImage
                                    try {
                                        var embRaw = favCell.add(0x48).readPointer();
                                        if (!embRaw.isNull()) {
                                            var embTex = loadLocalTexture2D(embPath);
                                            if (embTex && !embTex.isNull()) {
                                                var setTexFn = new NativeFunction(baseAddr.add(0x194C074), "void", ["pointer", "pointer", "pointer"]);
                                                setTexFn(embRaw, embTex, NULL);
                                                var setNativeSizeFn = new NativeFunction(baseAddr.add(0x194C1C8), "void", ["pointer", "pointer"]);
                                                setNativeSizeFn(embRaw, NULL);
                                                var rawGo = getGoFn(embRaw, NULL);
                                                if (!rawGo.isNull()) setActFn(rawGo, 1, NULL);
                                            }
                                        }
                                    } catch (eEm) {}
                                }
                            } else {
                                if (!favCell.isNull()) {
                                    var fvGo2 = getGoFn(favCell, NULL);
                                    if (!fvGo2.isNull()) setActFn(fvGo2, 0, NULL);
                                }
                                if (!emptyGo.isNull()) {
                                    setActFn(emptyGo, 1, NULL);
                                }
                                if (!bgGo.isNull()) {
                                    setActFn(bgGo, 0, NULL);
                                }
                            }
                        }
                        log("[📖 CARDBOOK] Populated " + Math.min(arrLen, favCodes.length) + " favorite groups in CardBookMainView!");
                    } catch (eFav) {
                        log("[-] Error in favorite groups population: " + eFav.message);
                    }
                };

                // Offline CardBook Collection Metrics (calculated dynamically from inventory & metadata)
                var offlineTotalCardsPossible = 197;
                var offlineTotalCardsOwned = 197;
                var offlineTotalThemesPossible = 31;
                var offlineTotalThemesCompleted = 31;
                var offlineTotalThemePointsPossible = 74400;
                var offlineTotalThemePointsEarned = 74400;

                var buildCollectionRewardData = function (type, currentPts, targetPts, rewardQuantity, rewardIconPath, missionType) {
                    var cellParamKlass = resolveMetadataSlot(0x31F0E80);
                    var rewardParamKlass = resolveMetadataSlot(0x31F41F8);
                    if (!cellParamKlass || cellParamKlass.isNull()) return NULL;

                    var cpObj = il2cpp_object_new(cellParamKlass);
                    if (il2cpp_gchandle_new && !cpObj.isNull()) il2cpp_gchandle_new(cpObj, 2);

                    // Canonical Dalcomsoft English from lcd.json (code 181416001: 'Achieve {0} points!')
                    var ptStr = createIl2CppString("Achieve " + targetPts.toLocaleString() + " points!");
                    cpObj.add(0x10).writePointer(ptStr);

                    if (rewardParamKlass && !rewardParamKlass.isNull()) {
                        var rpObj = il2cpp_object_new(rewardParamKlass);
                        if (il2cpp_gchandle_new && !rpObj.isNull()) il2cpp_gchandle_new(rpObj, 2);
                        var iconDp = createDownloadPath(rewardIconPath);
                        rpObj.add(0x10).writePointer(iconDp);
                        rpObj.add(0x18).writePointer(createIl2CppString(rewardQuantity));
                        rpObj.add(0x20).writeU8(0); // autoSize = false to preserve prefab 50x50 sizeDelta
                        cpObj.add(0x18).writePointer(rpObj);
                    }

                    cpObj.add(0x20).writePointer(createIl2CppString("RECEIVE"));
                    cpObj.add(0x28).writePointer(createIl2CppString("COMPLETED"));
                    cpObj.add(0x30).writeS32((missionType !== undefined && missionType !== null) ? missionType : 0); // 0=progress, 1=Reward, 2=Completed
                    return cpObj;
                };

                var createCollectionPointViewParam = function (title, subNotice, notice, curPts, maxPts, buffScore, cellParam) {
                    var paramKlass = resolveMetadataSlot(0x31F0E88);
                    if (!paramKlass || paramKlass.isNull()) return NULL;

                    var pObj = il2cpp_object_new(paramKlass);
                    if (il2cpp_gchandle_new && !pObj.isNull()) il2cpp_gchandle_new(pObj, 2);

                    pObj.add(0x10).writePointer(createIl2CppString(title));
                    pObj.add(0x18).writePointer(createIl2CppString(subNotice));
                    pObj.add(0x20).writePointer(createIl2CppString(notice));
                    pObj.add(0x28).writePointer(createIl2CppString("{0} / {1}"));
                    pObj.add(0x30).writeS32(curPts);
                    pObj.add(0x34).writeS32(maxPts);
                    pObj.add(0x38).writePointer(createIl2CppString("BUFF"));
                    pObj.add(0x40).writeS32(buffScore);
                    if (cellParam && !cellParam.isNull()) {
                        pObj.add(0x48).writePointer(cellParam);
                    }
                    return pObj;
                };

                var populateCollectionPointsOffline = function (sceneThis) {
                    try {
                        if (!sceneThis || sceneThis.isNull()) return;
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (sceneView.isNull()) return;
                        var mainView = sceneView.add(0xE0).readPointer();
                        if (mainView.isNull()) return;

                        var cardColPoint = mainView.add(0x68).readPointer();
                        var themeColPoint = mainView.add(0x70).readPointer();
                        var setColFn = new NativeFunction(baseAddr.add(0x11C5184), "void", ["pointer", "pointer", "pointer"]);

                        var curCards = offlineTotalCardsOwned;
                        var totCards = offlineTotalCardsPossible;
                        var curThemes = offlineTotalThemePointsEarned;
                        var totThemes = offlineTotalThemePointsPossible;

                        var prof = loadPlayerProfile();
                        var claimedObj = (prof && prof.collectionRewardsClaimed) ? prof.collectionRewardsClaimed : { card: 0, theme: 0 };

                        var resolveTierState = function(tiers, claimedLvl, curPts) {
                            var nextTier = null;
                            for (var ti = 0; ti < tiers.length; ti++) {
                                if (tiers[ti].level > claimedLvl) {
                                    nextTier = tiers[ti];
                                    break;
                                }
                            }
                            if (!nextTier) {
                                var lastT = tiers.length > 0 ? tiers[tiers.length - 1] : { pointValue: curPts, rewardQuantity: 0 };
                                return { targetPts: lastT.pointValue, rewardStr: (lastT.rewardQuantity || 0).toLocaleString(), missionType: 2 };
                            }
                            return {
                                targetPts: nextTier.pointValue,
                                rewardStr: (nextTier.rewardQuantity || 0).toLocaleString(),
                                missionType: (curPts >= nextTier.pointValue) ? 1 : 0
                            };
                        };

                        if (!cardColPoint.isNull()) {
                            var cTiers = getCacTiers(0);
                            var cState = resolveTierState(cTiers, parseInt(claimedObj.card || 0, 10), curCards);
                            var cpCell = buildCollectionRewardData("card", curCards, cState.targetPts, cState.rewardStr, "asiudgasg/asodhsg/bhfbfhbf/317.i.bytes", cState.missionType);
                            var cpParam = createCollectionPointViewParam(
                                "ALL CARDS COLLECTION",
                                "*Any Theme is available.",
                                "Collect new cards and get rewards!\n1 point per Card!",
                                curCards,
                                totCards,
                                50,
                                cpCell
                            );
                            if (cpParam && !cpParam.isNull()) {
                                setColFn(cardColPoint, cpParam, NULL);
                            }
                        }
                        if (!themeColPoint.isNull()) {
                            var tTiers = getCacTiers(1);
                            var tState = resolveTierState(tTiers, parseInt(claimedObj.theme || 0, 10), curThemes);
                            var tpCell = buildCollectionRewardData("theme", curThemes, tState.targetPts, tState.rewardStr, "asiudgasg/asodhsg/bhfbfhbf/968.i.bytes", tState.missionType);
                            var tpParam = createCollectionPointViewParam(
                                "ALL THEMES COLLECTION",
                                "*Any Theme is available.",
                                "Add points by matching your Themes in C~R Grades for reward!",
                                curThemes,
                                totThemes,
                                50,
                                tpCell
                            );
                            if (tpParam && !tpParam.isNull()) {
                                setColFn(themeColPoint, tpParam, NULL);
                            }
                        }

                        // Explicit high-fidelity texture binding for CardBook reward icons
                        try {
                            var setTextureFn = new NativeFunction(baseAddr.add(0x194C074), "void", ["pointer", "pointer", "pointer"]);
                            var setColourFn = new NativeFunction(baseAddr.add(0x14E69AC), "void", ["pointer", "float", "float", "float", "float", "pointer"]);
                            var diaTex = loadLocalTexture2D("asiudgasg/asodhsg/bhfbfhbf/317.i.bytes");
                            var rpTex = loadLocalTexture2D("asiudgasg/asodhsg/bhfbfhbf/968.i.bytes");

                            if (!cardColPoint.isNull() && diaTex && !diaTex.isNull()) {
                                var cAch = cardColPoint.add(0x60).readPointer();
                                if (!cAch.isNull()) {
                                    var cRwView = cAch.add(0x48).readPointer();
                                    if (!cRwView.isNull()) {
                                        var cRwImg = cRwView.add(0x38).readPointer();
                                        if (!cRwImg.isNull()) {
                                            setTextureFn(cRwImg, diaTex, NULL);
                                            try {
                                                setColourFn(cRwImg, 1.0, 1.0, 1.0, 1.0, NULL);
                                            } catch (eColC) {}
                                        }
                                    }
                                }
                            }
                            if (!themeColPoint.isNull() && rpTex && !rpTex.isNull()) {
                                var tAch = themeColPoint.add(0x60).readPointer();
                                if (!tAch.isNull()) {
                                    var tRwView = tAch.add(0x48).readPointer();
                                    if (!tRwView.isNull()) {
                                        var tRwImg = tRwView.add(0x38).readPointer();
                                        if (!tRwImg.isNull()) {
                                            setTextureFn(tRwImg, rpTex, NULL);
                                            try {
                                                setColourFn(tRwImg, 1.0, 1.0, 1.0, 1.0, NULL);
                                            } catch (eColT) {}
                                        }
                                    }
                                }
                            }
                            log("[📖 CARDBOOK] Assigned high-fidelity Diamond & RP reward icons directly to RawImages!");
                        } catch (eRwBind) {
                            log("[-] Error binding reward icons directly: " + eRwBind.message);
                        }

                        log("[📖 CARDBOOK] Populated collection points in CardBookMainView: Cards " + curCards + "/" + totCards + " | Themes " + curThemes + "/" + totThemes);
                    } catch (eCol) {
                        log("[-] Error in collection points population: " + eCol.message);
                    }
                };

                var populateCardBookMainViewOffline = function (sceneThis) {
                    try {
                        if (!sceneThis || sceneThis.isNull()) return;
                        var sceneView = sceneThis.add(0x48).readPointer();
                        if (sceneView.isNull()) return;
                        var mainView = sceneView.add(0xE0).readPointer();
                        if (mainView.isNull()) return;

                        // 0. Hide othersBase (UICache at sceneView + 0x48)
                        try {
                            var othersBase = sceneView.add(0x48).readPointer();
                            if (!othersBase.isNull()) {
                                var setActFn = new NativeFunction(baseAddr.add(0x1DBADF4), "void", ["pointer", "bool", "pointer"]);
                                var oGo = othersBase.add(0x10).readPointer();
                                if (!oGo.isNull()) setActFn(oGo, 0, NULL);
