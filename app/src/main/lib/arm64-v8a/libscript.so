                                var cMeta = getCardMetadata(c.cardID);
                                var cardGroup = (cMeta && (cMeta.groupID || cMeta.group)) ? (cMeta.groupID || cMeta.group) : (c.groupID || 1001);
                                var cardArtist = (cMeta && cMeta.artistID) ? cMeta.artistID : (c.artistID || c.cardID);
