                        var gMeta = (metaAll && metaAll.groups) ? (metaAll.groups[gCode] || metaAll.groups[gCode.toString()]) : null;
                        var artistCodes = (gMeta && gMeta.artistCodes) ? gMeta.artistCodes : [];

