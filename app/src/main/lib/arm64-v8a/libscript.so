                                hideTermsFn(sceneView);
                                var hideIntroFn = new NativeFunction(baseAddr.add(0xB2A03C), "void", ["pointer"]);
                                hideIntroFn(sceneView);
                                var showMainFn = new NativeFunction(baseAddr.add(0xB24534), "void", ["pointer"]);
