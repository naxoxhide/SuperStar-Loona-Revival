        return NULL;
    }

    function readIl2CppString(strPtr) {
        if (!strPtr || strPtr.isNull()) return "";
        try {
            var len = strPtr.add(Process.pointerSize * 2).readInt();
            if (len > 0 && len < 20000) {
                return strPtr.add(Process.pointerSize * 2 + 4).readUtf16String(len);
            }
        } catch (e) {}
        return "";
