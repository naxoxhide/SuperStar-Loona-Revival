                            var cIdB = rawB.add(0x20).readS32();
                            var grA = rawA.add(0x24).readS32();
                            var grB = rawB.add(0x24).readS32();
                            var lvlA = rawA.add(0x1C).readS16();
                            var lvlB = rawB.add(0x1C).readS16();
