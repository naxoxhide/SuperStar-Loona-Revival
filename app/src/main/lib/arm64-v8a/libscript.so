                                log("[🎬 VIDEO ACTIVATOR] VideoControl fully initialized and Open(MOVIE_TYPE.Main = 1) dispatched!");

                                // Get current MediaPlayer and link to DisplayUGUI (offset 0x28)
                                var getCurMpFn = new NativeFunction(baseAddr.add(0xABB000), "pointer", ["pointer"]);
                                var mp = getCurMpFn(vc);
                                var display = vc.add(0x28).readPointer();
                                if (!display.isNull() && !mp.isNull()) {
                                    display.add(0xD0).writePointer(mp); // _mediaPlayer in DisplayUGUI
                                    var dispGo = getGoFn(display);
                                    if (!dispGo.isNull()) {
                                        setActiveFn(dispGo, 1);
                                        log("[🎬 VIDEO ACTIVATOR] Activated VideoControl display: " + dispGo);
                                    }
                                }

                                if (!mp.isNull()) {
                                    var mpGo = getGoFn(mp);
                                    if (!mpGo.isNull()) {
                                        setActiveFn(mpGo, 1);
                                    }
                                    var openVideoFn = new NativeFunction(baseAddr.add(0xCAEFC4), "int", ["pointer", "int", "pointer", "int"]);
                                    var playFn = new NativeFunction(baseAddr.add(0xCB0170), "void", ["pointer"]);

                                    var res = openVideoFn(mp, 0, strIl2CppUri, 1);
                                    playFn(mp);
                                    log("[🎬 VIDEO ACTIVATOR] Direct MediaPlayer.OpenVideoFromFile returned: " + res + " and Play() called!");
                                }
                            }
                        } catch (ve) {
                            log("[-] Error activating VideoControl: " + ve.message);
                        }

                        // 3. Dismiss Fade Overlay cleanly WITHOUT purging Fade.instance or deactivating its GameObject
                        //    (Purging Fade.instance = null breaks Fade.Out/Fade.In callbacks such as SelectMusicScene -> IngameLoadingScene!)
                        try {
                            var fadeSetIsActiveFn = new NativeFunction(baseAddr.add(0xD2EBA8), "void", ["int"]);
                            fadeSetIsActiveFn(0);

                            var fadeCloseFn = new NativeFunction(baseAddr.add(0xD2FAB4), "void", []);
                            fadeCloseFn();

                            var fadeStopFn = new NativeFunction(baseAddr.add(0xD2FD24), "void", []);
                            fadeStopFn();
                            log("[🛡️ FADE DISMISSED] Fade.Close & Stop called cleanly (instance preserved)!");
                        } catch (fe) {
                            log("[-] Error dismissing Fade: " + fe.message);
                        }

                        // --- Submenu Customization: Ocultar botón de Ranking (-League / Weekly League) ---
                        // (Para reactivar el botón de Ranking en el Lobby, comenta este bloque o cambia el valor a 1)
                        try {
                            var leaguePaths = [
                                "LobbyScene/Buttons/RightMenu/-extraMenu/BtnMyLobby/-League",
                                "-League",
                                "RightMenu/-extraMenu/BtnMyLobby/-League"
                            ];
                            leaguePaths.forEach(function (lpath) {
                                try {
                                    var lgo = findGameObjectFn(createIl2CppString(lpath), NULL);
                                    if (!lgo.isNull()) {
                                        setActiveFn(lgo, 0); // 0 = Ocultar / 1 = Mostrar
                                        log("[🏆 SUBMENU] Ranking button (-League) hidden successfully! (" + lpath + ")");
                                    }
                                } catch (e) {}
                            });
                        } catch (eLeague) {
                            log("[-] Error hiding -League ranking button: " + eLeague.message);
                        }

                        // --- Initialize InventoryControl on Lobby startup ---
                        try {
                            populateOfflineInventoryCards();
                            log("[🃏 INVENTORY] Offline inventory initialized cleanly on Lobby init!");
                        } catch (eInv) {
                            log("[-] Error initializing offline Inventory on Lobby init: " + eInv.message);
                        }

                        // --- Restore and Activate TopView in LobbyScene ---
                        try {
                            activateTopView(3);
                            log("[👑 LOBBY ACTIVATOR] activateTopView(3) executed on Lobby init!");
                        } catch (eTopAct) {
                            log("[-] Error calling activateTopView on Lobby init: " + eTopAct.message);
                        }

                        lobbyUIActivated = true;
                    } catch (e) {
                        log("[-] General error in activateLobbyUIAndVideo: " + e.message);
                    }
                }

                // =========================================================================
                // 🃏 DALCOMSOFT OFFLINE CARD SYSTEM & INVENTORY POPULATOR
                // =========================================================================
                var LOONA_MEMBERS = [
                    { index: 1, name: "HeeJin", krName: "희진" },
                    { index: 2, name: "HyunJin", krName: "현진" },
                    { index: 3, name: "HaSeul", krName: "하슬" },
                    { index: 4, name: "YeoJin", krName: "여진" },
                    { index: 5, name: "ViVi", krName: "비비" },
                    { index: 6, name: "Kim Lip", krName: "김립" },
                    { index: 7, name: "JinSoul", krName: "진솔" },
                    { index: 8, name: "Choerry", krName: "최리" },
                    { index: 9, name: "Yves", krName: "이브" },
                    { index: 10, name: "Go Won", krName: "고원" },
                    { index: 11, name: "Olivia Hye", krName: "올리비아 혜" }
                ];

                var downloadPathKlass = NULL;
                function getDownloadPathClass() {
                    if (downloadPathKlass && !downloadPathKlass.isNull()) {
                        return downloadPathKlass;
                    }

                    // Strategy 1: Check if the TypeInfo slot is already resolved to a valid Il2CppClass*
                    try {
                        var slotVal = baseAddr.add(0x31F74F8).readPointer();
                        // A valid Il2CppClass* will be a high heap address, not a metadata token like 0xc000ae17
                        if (!slotVal.isNull() && slotVal.compare(ptr(0x100000000)) > 0) {
                            downloadPathKlass = slotVal;
                            log("[+] Resolved WWWFile.DownloadPath class from pre-resolved TypeInfo slot: " + slotVal);
                            return downloadPathKlass;
                        }
                    } catch (eSlot) {}

                    // Strategy 2: Use nested types API (primary safe method)
                    try {
                        var wwwFileKlass = getClass("Assembly-CSharp", "Ext.Unity3D.Cdn", "WWWFile");
                        if (!wwwFileKlass || wwwFileKlass.isNull()) {
                            wwwFileKlass = getClass("Assembly-CSharp-firstpass", "Ext.Unity3D.Cdn", "WWWFile");
                        }
                        if (wwwFileKlass && !wwwFileKlass.isNull()) {
                            var getNestedFn = new NativeFunction(Module.findExportByName("libil2cpp.so", "il2cpp_class_get_nested_types"), 'pointer', ['pointer', 'pointer']);
                            var getNameFn = new NativeFunction(Module.findExportByName("libil2cpp.so", "il2cpp_class_get_name"), 'pointer', ['pointer']);
                            var iter = Memory.alloc(Process.pointerSize);
                            iter.writePointer(NULL);
                            var nested;
                            while (!(nested = getNestedFn(wwwFileKlass, iter)).isNull()) {
                                var nName = getNameFn(nested).readUtf8String();
                                if (nName === "DownloadPath") {
                                    downloadPathKlass = nested;
                                    log("[+] Resolved WWWFile.DownloadPath class via nested types: " + nested);
                                    return downloadPathKlass;
                                }
                            }
                        }
                    } catch (eNest) {
                        log("[-] Error resolving DownloadPath via nested types: " + eNest.message);
                    }
                    return NULL;
                }

                function getIl2CppClassFromSlot(slotRva) {
                    try {
                        var slot = baseAddr.add(slotRva);
                        var ptr1 = slot.readPointer();
                        if (!ptr1.isNull() && ptr1.compare(ptr(0x100000000)) > 0) {
                            return ptr1;
                        }
                    } catch (e) {}
                    return NULL;
                }

                function createDownloadPath(relPath) {
                    var step = "getClass";
                    var dp = NULL;
                    try {
                        var klass = getDownloadPathClass();
                        if (!klass || klass.isNull()) return NULL;
                        step = "object_new";
                        dp = il2cpp_object_new(klass);
                        if (!dp || dp.isNull() || dp.compare(ptr(0x10000000)) <= 0) {
                            log("[-] Invalid dp ptr from il2cpp_object_new(" + klass + "): " + dp + " for " + relPath);
                            return NULL;
                        }
                        step = "str_url";
                        var urlStr = createIl2CppString("https://dalcom.local/" + relPath);
                        step = "str_rel";
                        var relStr = createIl2CppString(relPath);
                        step = "str_ver";
                        var verStr = createIl2CppString("1");
                        step = "write_fields";
                        dp.add(0x10).writePointer(urlStr);
                        dp.add(0x18).writePointer(relStr);
                        dp.add(0x20).writePointer(verStr);
                        dp.add(0x28).writeU8(0);
                        dp.add(0x29).writeU8(1); // shared = true (was 0)
                        dp.add(0x2A).writeU8(0);
                        dp.add(0x30).writePointer(NULL);
                        dp.add(0x38).writeS32(1); // Texture = 1
                        return dp;
                    } catch (eDp) {
                        log("[-] Error creating DownloadPath [" + step + " dp=" + dp + "] for " + relPath + ": " + eDp.message);
                        return NULL;
                    }
                }

                var accountOwnedCards = {};
                var accountOwnedPrismCards = {};

                function syncAccountOwnedCards() {
                    try {
                        var prof = loadPlayerProfile();
                        accountOwnedCards = {};
                        accountOwnedPrismCards = {};
                        if (prof && prof.inventoryCards && prof.inventoryCards.length > 0) {
                            for (var i = 0; i < prof.inventoryCards.length; i++) {
                                var ic = prof.inventoryCards[i];
                                if (!ic || !ic.cardID) continue;
                                var gr = (ic.grade !== undefined && ic.grade !== null) ? ic.grade : 0;
                                var lvl = ic.level || 1;
                                var meta = (typeof getCardMetadata === "function") ? getCardMetadata(ic.cardID) : null;
                                var isPr = !!(ic.isPrism || (meta && meta.type === 1));
                                if (!accountOwnedCards[ic.cardID] || gr > accountOwnedCards[ic.cardID].grade) {
                                    accountOwnedCards[ic.cardID] = { grade: gr, level: lvl, isPrism: isPr };
                                }
                                if (isPr) {
                                    if (!accountOwnedPrismCards[ic.cardID] || gr > accountOwnedPrismCards[ic.cardID].grade) {
                                        accountOwnedPrismCards[ic.cardID] = { grade: gr, level: lvl };
                                    }
                                }
                            }
                            log("[🗃️ OWNED CARDS] Synced " + prof.inventoryCards.length + " cards (" + Object.keys(accountOwnedCards).length + " unique, " + Object.keys(accountOwnedPrismCards).length + " prism)!");
                        } else {
                            // Default starter fallback only before profile creation
                            for (var di = 1001; di <= 1011; di++) {
                                accountOwnedCards[di] = { grade: 4, level: 50, isPrism: false };
                            }
                        }
                    } catch (eSc) {
                        log("[-] Error in syncAccountOwnedCards: " + eSc.message);
                    }
                }
                syncAccountOwnedCards();

                // grade: 0=C, 1=B, 2=A, 3=S, 4=R
                // type: 0=Large (_l), 1=Small (_s), 2=Collection (_c)
                function getGradeFrameDownloadPath(grade, type, isCollection, themeCode) {
                    var tc = (themeCode !== undefined && themeCode !== null) ? themeCode : 0;
                    var g = "c";
                    if (grade === 1) g = "b";
                    else if (grade === 2) g = "a";
                    else if (grade === 3) g = "s";
                    else if (grade === 4) g = "r";

                    var variant = "s";
                    if (isCollection || type === 2) variant = "c";
                    else if (type === 0) variant = "l";

                    var fname = "";
                    if (g === "b") {
                        fname = tc + "b_" + variant + ".i.bytes";
                    } else if (g === "c" && variant === "l") {
                        fname = tc + "c_l.i.bytes";
                    } else {
                        fname = tc + "_" + g + "_" + variant + ".i.bytes";
                    }

                    return createDownloadPath("asiudgasg/asodhsg/aoeiwhslc/uhex/" + fname);
                }

                // =========================================================================
                // 📊 CARD STATS (cbd.json) & METADATA (cdd.json, tmd.json) ENGINE
                // =========================================================================
                var cbdCache = null;
                var cbdByCode = null;
                var cidCache = null;
                var cidByCode = null;
                var cgdCache = null;
                var csdCache = null;
                var csdByCode = null;
                var gcdCache = null;
                var gcdByCode = null;
                var cachedThemeAbilityValues = null;
                var cachedThemeAbilityListPtr = NULL;

                function getMaxCardLevel(grade) {
                    return (parseInt(grade, 10) === 4) ? 50 : 5;
                }

                function getIntensifyCode(grade, level) {
                    var gr = parseInt(grade, 10);
                    if (isNaN(gr) || gr < 0) gr = 0;
                    if (gr > 4) gr = 4;
                    var maxLvl = getMaxCardLevel(gr);
                    var lvl = parseInt(level, 10);
                    if (isNaN(lvl) || lvl < 1) lvl = 1;
                    if (lvl > maxLvl) lvl = maxLvl;
                    return (gr < 4) ? (gr * 5 + (lvl - 1)) : (20 + (lvl - 1));
                }

                function objIdKey(val) {
                    return (val === null || val === undefined) ? "0" : val.toString();
                }

                function indexTableByCode(arr) {
                    var map = {};
                    if (Array.isArray(arr)) {
                        for (var i = 0; i < arr.length; i++) {
                            var entry = arr[i];
                            if (entry && entry.code !== undefined) map[entry.code] = entry;
                        }
                    }
                    return map;
                }

                function loadOfflineCardDataTables() {
                    if (!cbdCache) {
                        try {
                            var rawCbd = readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/asiudgasg/sdisgkdc/cbd.json") ||
                                         readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/data/cbd.json");
                            if (rawCbd) {
                                cbdCache = JSON.parse(rawCbd);
                                cbdByCode = indexTableByCode(cbdCache);
                                log("[📊 CBD] Loaded cbd.json: " + cbdCache.length + " card balance levels cached!");
                            }
                        } catch (eCbd) { log("[-] Error loading cbd.json: " + eCbd.message); }
                    }
                    if (!cidCache) {
                        try {
                            var rawCid = readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/asiudgasg/sdisgkdc/cid.json") ||
                                         readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/data/cid.json");
                            if (rawCid) {
                                cidCache = JSON.parse(rawCid);
                                cidByCode = indexTableByCode(cidCache);
                                log("[📊 CID] Loaded cid.json: " + cidCache.length + " intensify matrix entries cached!");
                            }
                        } catch (eCid) { log("[-] Error loading cid.json: " + eCid.message); }
                    }
                    if (!cgdCache) {
                        try {
                            var rawCgd = readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/asiudgasg/sdisgkdc/cgd.json") ||
                                         readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/data/cgd.json");
                            if (rawCgd) {
                                cgdCache = JSON.parse(rawCgd);
                                log("[📊 CGD] Loaded cgd.json: " + cgdCache.length + " card grade bonus entries cached!");
                            }
                        } catch (eCgd) {}
                    }
                    if (!csdCache) {
                        try {
                            var rawCsd = readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/asiudgasg/sdisgkdc/csd.json") ||
                                         readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/data/csd.json");
                            if (rawCsd) {
                                csdCache = JSON.parse(rawCsd);
                                csdByCode = indexTableByCode(csdCache);
                                log("[📊 CSD] Loaded csd.json: " + csdCache.length + " card sell entries cached!");
                            }
                        } catch (eCsd) {}
                    }
                    if (!gcdCache) {
                        try {
                            var rawGcd = readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/asiudgasg/sdisgkdc/gcd.json") ||
                                         readTextFile("/storage/emulated/0/Android/data/com.dalcomsoft.sslo/files/data/gcd.json");
                            if (rawGcd) {
                                gcdCache = JSON.parse(rawGcd);
                                gcdByCode = indexTableByCode(gcdCache);
                                log("[📊 GCD] Loaded gcd.json: " + gcdCache.length + " game config entries cached!");
                            }
                        } catch (eGcd) {}
                    }
                }

                function getThemeAbilityValues() {
                    if (cachedThemeAbilityValues) return cachedThemeAbilityValues;
                    loadOfflineCardDataTables();
                    var vals = [1, 2, 3];
                    try {
                        if (gcdByCode) {
                            var codes = [15801, 15802, 15803];
                            for (var i = 0; i < 3; i++) {
                                var entry = gcdByCode[codes[i]];
                                if (entry && entry.integerValue !== undefined && entry.integerValue !== null) {
                                    var parsed = parseInt(entry.integerValue, 10);
                                    if (!isNaN(parsed) && parsed > 0) vals[i] = parsed;
                                }
                            }
                        }
                    } catch (eTav) {}
                    cachedThemeAbilityValues = vals;
                    return vals;
                }

                function getManagedThemeAbilityValuesList() {
                    if (cachedThemeAbilityListPtr && !cachedThemeAbilityListPtr.isNull()) {
                        return cachedThemeAbilityListPtr;
                    }
                    try {
                        var listObj = createManagedList(getThemeAbilityValues(), 'int');
                        if (listObj && !listObj.isNull()) {
                            cachedThemeAbilityListPtr = listObj;
                            // Keep InventoryControl.ThemeAbilityValues (static +0x28) synced if initialized
                            try {
                                var invCtrlSlot = baseAddr.add(0x30ED358);
                                var invCtrlKlass = invCtrlSlot.readPointer();
                                if (invCtrlKlass && !invCtrlKlass.isNull()) {
                                    var staticFields = invCtrlKlass.add(0xB8).readPointer();
                                    if (staticFields && !staticFields.isNull()) {
                                        staticFields.add(0x28).writePointer(listObj);
                                    }
                                }
                            } catch (eInvStatic) {}
                            return listObj;
                        }
                    } catch (eMtl) {}
                    return NULL;
                }

                function computeGroupThemeBuffState(groupId, profileOpt) {
                    var gId = parseInt(groupId, 10) || 1001;
                    var gMeta = getGroupMetadata(gId);
                    var memberCount = (gMeta && gMeta.equipableSlot) ? (parseInt(gMeta.equipableSlot, 10) || 11) : 11;
                    var inactiveArtistCount = 0;
                    var activeMembers = Math.max(1, memberCount - inactiveArtistCount);
                    var thresholds = [
                        Math.ceil((activeMembers / 3.0) * 1),
                        Math.ceil((activeMembers / 3.0) * 2),
                        Math.ceil((activeMembers / 3.0) * 3)
                    ];

                    var profile = profileOpt;
                    if (!profile) {
                        try { profile = loadPlayerProfile(); } catch (eP) { profile = null; }
                    }

                    var themeCounts = {};
                    var themeLevels = {};
                    var memberEquipped = {};
                    var eqCount = 0;
                    var minGrade = 4;
                    var bestThemeId = -1;
                    var maxThemeMatches = 0;

                    if (profile && profile.inventoryCards) {
                        for (var i = 0; i < profile.inventoryCards.length; i++) {
                            var c = profile.inventoryCards[i];
                            if (!c || !c.isEquip) continue;
                            var cm = getCardMetadata(c.cardID);
                            var cGroup = (cm && (cm.groupID || cm.group)) ? (cm.groupID || cm.group) : (c.groupID || 1001);
                            if (cGroup !== gId) continue;

                            var aId = (cm && cm.artistID) ? cm.artistID : (c.artistID || c.cardID);
                            if (memberEquipped[aId]) continue;
                            memberEquipped[aId] = true;
                            eqCount++;

                            if (c.grade !== undefined && c.grade < minGrade) minGrade = c.grade;
                            var tId = (cm && cm.theme) ? cm.theme : (c.themeID || 1001);
                            var tMeta = getThemeMetadata(tId);
                            if (tMeta && tMeta.rehearsalTheme) continue;

                            themeCounts[tId] = (themeCounts[tId] || 0) + 1;
                        }
                    }

                    for (var thKey in themeCounts) {
                        var cnt = themeCounts[thKey];
                        var thNum = parseInt(thKey, 10);
                        var lv = 0;
                        if (cnt >= thresholds[2]) lv = 3;
                        else if (cnt >= thresholds[1]) lv = 2;
                        else if (cnt >= thresholds[0]) lv = 1;
                        themeLevels[thNum] = lv;
                        if (cnt > maxThemeMatches) {
                            maxThemeMatches = cnt;
                            bestThemeId = thNum;
                        }
                    }

                    var groupThemeLevel = (bestThemeId > 0) ? (themeLevels[bestThemeId] || 0) : 0;
                    return {
                        groupId: gId,
                        memberCount: memberCount,
                        inactiveArtistCount: inactiveArtistCount,
                        activeMembers: activeMembers,
                        thresholds: thresholds,
                        themeCounts: themeCounts,
                        themeLevels: themeLevels,
                        eqCount: eqCount,
                        isGroupComplete: (eqCount === memberCount),
                        minGrade: minGrade,
                        bestThemeId: bestThemeId,
                        maxThemeMatches: maxThemeMatches,
                        groupThemeLevel: groupThemeLevel
                    };
                }

                function computeCardThemeInfo(cardId, isEquipped, profileOpt) {
                    var meta = getCardMetadata(cardId);
                    var gId = (meta && (meta.groupID || meta.group)) ? (meta.groupID || meta.group) : (currentSelectedGroupCode || 1001);
                    var tId = (meta && meta.theme) ? meta.theme : 1001;
                    var tMeta = getThemeMetadata(tId);
                    var state = computeGroupThemeBuffState(gId, profileOpt);
                    var lv = 0;
                    if (isEquipped && !(tMeta && tMeta.rehearsalTheme)) {
                        lv = state.themeLevels[tId] || 0;
                    }
                    return {
                        groupId: gId,
                        themeId: tId,
                        memberCount: state.memberCount,
                        inactiveArtistCount: state.inactiveArtistCount,
                        thresholds: state.thresholds,
                        matchedCount: state.themeCounts[tId] || 0,
                        themeLevel: lv
                    };
                }

                function syncGroupCardThemeLevels(groupId, profileOpt) {
                    try {
                        var gId = parseInt(groupId, 10) || 1001;
                        var state = computeGroupThemeBuffState(gId, profileOpt);
                        if (loonaCardItems && loonaCardItems.length > 0) {
                            for (var i = 0; i < loonaCardItems.length; i++) {
                                var itm = loonaCardItems[i];
                                if (!itm || itm.isNull()) continue;
                                try {
                                    var raw = itm.add(0x10).readPointer();
                                    if (raw.isNull()) continue;
                                    var cId = raw.add(0x20).readS32();
                                    var cMeta = getCardMetadata(cId);
                                    var cGroup = (cMeta && (cMeta.groupID || cMeta.group)) ? (cMeta.groupID || cMeta.group) : 1001;
                                    if (cGroup !== gId) continue;
                                    var isEq = (raw.add(0x28).readU8() === 1);
                                    var tId = (cMeta && cMeta.theme) ? cMeta.theme : 1001;
                                    var tMeta = getThemeMetadata(tId);
                                    var lv = (isEq && !(tMeta && tMeta.rehearsalTheme)) ? (state.themeLevels[tId] || 0) : 0;
                                    itm.add(0x38).writeS32(lv);
                                } catch (eCi) {}
                            }
                        }
                        var gItemObj = allInvenGroupItems[gId];
                        if (gItemObj && !gItemObj.isNull()) {
                            try {
                                gItemObj.add(0x50).writeS32(state.bestThemeId);
                                gItemObj.add(0x54).writeS32(state.groupThemeLevel);
                            } catch (eGi) {}
                        }
                    } catch (eSync) {}
                }

                function getCardBaseStats(grade, level, isPrism) {
                    loadOfflineCardDataTables();
                    grade = parseInt(grade, 10) || 0;
                    level = Math.max(1, Math.min(getMaxCardLevel(grade), parseInt(level, 10) || 1));
                    var code = getIntensifyCode(grade, level);

                    var score = 100;
                    var energy = 100;
                    var item = (cbdByCode && cbdByCode[code]) || (cbdCache && cbdCache[code]) || null;
                    if (item) {
                        score = item.minScore + (isPrism ? (item.prizmScore || 10) : 0);
                        energy = item.minEnergy || 100;
                    } else {
                        // Official Dalcomsoft fallback formulas
                        if (grade === 0) { score = 10 + (level - 1) * 3; energy = score; }
                        else if (grade === 1) { score = 25 + (level - 1) * 3; energy = score; }
                        else if (grade === 2) { score = 40 + (level - 1) * 5; energy = score; }
                        else if (grade === 3) { score = 65 + (level - 1) * 7; energy = score; }
                        else if (grade === 4) { score = Math.min(199, 101 + (level - 1) * 2); energy = 100; }
                        if (isPrism) score += 10;
                    }
                    return { score: score, energy: energy };
                }

                function getIntensifyPriceAndRate(targetGrade, targetLevel, matGrade, matLevel) {
                    loadOfflineCardDataTables();
                    targetGrade = parseInt(targetGrade, 10) || 0;
                    targetLevel = Math.max(1, Math.min(getMaxCardLevel(targetGrade), parseInt(targetLevel, 10) || 1));
