                                        var gradeSpComp = st.add(0x60).readPointer();
                                        var gauge = st.add(0x48).readPointer();
                                        var grade = st.add(0x70).readPointer();
                                        if (!gaugeSpComp.isNull() && !gradeSpComp.isNull() && !gauge.isNull() && !grade.isNull()) {
