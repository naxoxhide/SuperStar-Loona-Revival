                                candidates.sort(function(a, b) {
                                    var ga = a.grade !== undefined ? a.grade : 0;
                                    var gb = b.grade !== undefined ? b.grade : 0;
                                    if (ga !== gb) return gb - ga;
                                    var la = a.level || 0;
                                    var lb = b.level || 0;
                                    if (la !== lb) return lb - la;
                                    var pa = a.isPrism ? 1 : 0;
                                    var pb = b.isPrism ? 1 : 0;
                                    return pb - pa;
