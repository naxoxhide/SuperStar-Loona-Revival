                            var vbAnim = globalMemberView.add(0x38).readPointer();
                            var vbTouch = globalMemberView.add(0x40).readPointer();
                            var vbRt = globalMemberView.add(0x48).readPointer();
                            var vbImg = globalMemberView.add(0x50).readPointer();
