                        for (var cl = 1; cl <= 100; cl++) {
                            cachedCacTiers[0].push({ code: cl - 1, level: cl, collectionPointType: 0, pointValue: cl * 20, rewardItem: 2, rewardQuantity: 10 + Math.floor((cl - 1) / 10) });
